import os
import glob
from SCons.Script import Dir
Import( 'testEnv' )
myEnv = testEnv.Clone();

# Please people, stop creating so many warnings!
myEnv.Append(CCFLAGS = ['-Werror', '-Wno-unused-function'])

# Include the super-project directory so that we can find lps_pass_tracker
# source files.
Repository('#/..')

myEnv.Append(CPPPATH = [
    myEnv[ 'SSP_DIR' ] + '/lps_common/include',
    myEnv[ 'SSP_DIR' ] + '/lps_app_common/include',
    myEnv[ 'SSP_DIR' ] + '/lps_pass_tracker/include'
])


SCONSCRIPT_DIR = Dir('.').abspath
BASE_PATH = os.path.abspath(
    os.path.join(SCONSCRIPT_DIR, "../../../../")
)
print("BASE_PATH =", BASE_PATH)


ros2_libs = []

ros2_lib_dir = BASE_PATH + '/ros2_models/lib'

for so in glob.glob(os.path.join(ros2_lib_dir, '*', 'lib*.so')):
    ros2_libs.append(os.path.basename(so)[3:-3])

print(ros2_libs)


for d in glob.glob(BASE_PATH + '/dependencies/cate_ros2*/include/*'):
    if os.path.isdir(d):
        myEnv.Append(CPPPATH=[d])

#ros2wrapper
for d in glob.glob(BASE_PATH + '/CPM-Loader-ais/prod/common/ros2wrapper'):
    if os.path.isdir(d):
        myEnv.Append(CPPPATH=[d])
         

myEnv.Append(
    CPPPATH=[
        BASE_PATH + '/ros2_models/include'
    ]
)
 


ROS_LIB_PATHS = [
    BASE_PATH + '/dependencies/cate_ros2*/lib',
    BASE_PATH + '/ros2_models/lib/cpm_common_interfaces',
    BASE_PATH + '/ros2_models/lib/job_mgr_interfaces',
    BASE_PATH + '/ros2_models/lib/weigh_app_interfaces',
    BASE_PATH + '/dependencies/libyaml_0.2.5/lib',
]

myEnv.Append(LIBPATH=ROS_LIB_PATHS)

myEnv.Append(
    LINKFLAGS=[
        flag
        for p in ROS_LIB_PATHS
        for flag in (
            '-Wl,-rpath,' + p,
            '-Wl,-rpath-link,' + p
        )
    ]
)
#------------------------------------------------------


sourceFiles = \
    Glob('*.cpp') + \
    Glob(myEnv[ 'SSP_DIR' ] + '/lps_pass_tracker/src/*.c')

base_libs = [    myEnv['BOOST_SERIALIZATION'],
                 myEnv['BOOST_FILESYSTEM'],
                 myEnv['BOOST_SYSTEM'],
                 'rclcpp',
                 'rcl_yaml_param_parser',
                 'yaml' ]    

LpsSaJobMgrApp = myEnv.Program( 
        target = 'LpsSaJobMgrApp',
        source = sourceFiles,
        LIBS = base_libs + ros2_libs
    )

myEnv.InstallBinary( LpsSaJobMgrApp )
ros2_cfg_dir = os.path.join(Dir('#').abspath, 'ros2_config')
myEnv.InstallConfig(ros2_cfg_dir, 'LpsSaJobMgrApp.yaml')
for f in glob.glob(os.path.join(ros2_cfg_dir, 'Robot_*.yaml')):
    myEnv.InstallConfig(ros2_cfg_dir, os.path.basename(f))
myEnv.Alias("JobMgrApp", "#bin/LpsSaJobMgrApp")

