#!/usr/bin/python
import os
import glob
from SCons.Script import Dir

Import( 'baseEnv' )
#Addon----------------------------------------
SCONSCRIPT_DIR = Dir('.').abspath
BASE_PATH = os.path.abspath(
    os.path.join(SCONSCRIPT_DIR, "../../")
)

for d in glob.glob(BASE_PATH + '/dependencies/cate_ros2*/include/*'):
    if os.path.isdir(d):
        baseEnv.Append(CPPPATH=[d])

baseEnv.Append(CPPPATH=[
    BASE_PATH + '/CPM-Loader-ais/prod/common',
    BASE_PATH + '/ros2_models/include',
])

commonEnv = baseEnv.Clone();
Export( 'commonEnv' )

for d in glob.glob(BASE_PATH + '/dependencies/cate_ros2*/include/*'):
    if os.path.isdir(d):
        commonEnv.Append(CPPPATH=[d])
#------------------------------------------------
commonEnv.buildit( 'interfaces', ['suse'] )
#commonEnv.buildit( 'jhm2', ['suse'] )
#commonEnv.buildit( 'task', ['suse'] )
#commonEnv.buildit( 'csvUtil', ['suse'] )
#commonEnv.buildit( 'vehicleConfigUtils', ['suse'] )
#commonEnv.buildit( 'version', ['suse'] )
#commonEnv.buildit( 'machineSerialNumber', ['suse'] )
commonEnv.buildit( 'LoaderdiagnosticEventConfig', ['suse'] )
commonEnv.buildit( 'sl_cal', ['suse'] )
