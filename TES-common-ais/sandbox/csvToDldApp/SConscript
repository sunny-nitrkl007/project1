#!/usr/bin/python
Import( 'testEnv' )

simAppEnv = testEnv.Clone()
simAppObject = simAppEnv.ProgramWrapper(
        target = 'csvToDldApp',
        source = [ 'csvToDldApp.cpp' ],
        LIBS = [ 'ais_task', 'csvUtil' ]
)

simAppEnv.InstallBinary( simAppObject )
simAppEnv.Alias('csvToDldApp', '#bin/csvToDldApp')
