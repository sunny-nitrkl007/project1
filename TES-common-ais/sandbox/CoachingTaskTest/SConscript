Import( 'testEnv' )
 
sourceFiles = [ 
    'CoachingTaskTest.cpp'
]

CoachingTaskTest = testEnv.Program( 
        target = 'CoachingTaskTest',
        source = sourceFiles,
        LIBS = [ 'ais_task', 'ais_config', 'ais_log'] 

    )

testEnv.InstallBinary( CoachingTaskTest )
testEnv.Alias("CoachingTaskTest", "#bin/CoachingTaskTest")


