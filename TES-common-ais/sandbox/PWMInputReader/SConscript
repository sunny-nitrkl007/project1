Import( 'testEnv' )
 
sourceFiles = [ 
    'PWMInputReader.cpp'
]

PWMInputReader = testEnv.Program( 
        target = 'PWMInputReader',
        source = sourceFiles,
        LIBS = [ 'ais_task', 'ais_config', 'ais_log'] 

    )

testEnv.InstallBinary( PWMInputReader )
testEnv.Alias("PWMInputReader", "#bin/PWMInputReader")


