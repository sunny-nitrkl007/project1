#!/bin/bash

## Software Information and Verity Naming
## Verity format: (VERITY_PREFIX)_(PLATFORM)_(SOFTWARE_PART_NUMBER)_(SOFTWARE_CHANGE_NUMBER)_(SOFTWARE_BUILD_ID).verity

export SOFTWARE_PART_NUMBER=5946660
                          # ^^^^^^^                                7 bytes, used for Software Group Part Number

# 2 bytes, used for Software Group Part Number
export SOFTWARE_CHANGE_NUMBER=09
                            # ^^

# 7 bytes, used for Software Group Part Number
export SOFTWARE_RELEASE_DATE=FEB2022
                           # ^^^^^^^

# 26 bytes, used for Software Group Part Number, spaces are permitted if encased on quotes
# NOTE: Cannot contain the name of the ECM (A6N1, A6N2, etc), it will be replaced with '1' by the preprocessor
export SOFTWARE_GROUP_DESCRIPTION="Phase 12 TEST V09_T02     "
                                 # ^^^^^^^^^^^^^^^^^^^^^^^^^^

# Used for Verity name
export SOFTWARE_BUILD_ID=T02

# Used for getversion, name of the release zip file
export SWVERSION=${SOFTWARE_PART_NUMBER}-${SOFTWARE_CHANGE_NUMBER}${SOFTWARE_RELEASE_DATE}${SOFTWARE_BUILD_ID}

## RPA Client

# 6 Bytes max
export SOFTWARE_NAME_CODE=A4047
                        # ^^^^^^

# Must be int16
export FLASH_APPLICATION_ID=121

## RPA Client - Must be int16
export FLASH_COMPONENT_ID=52
