Import( 'testEnv' )

localEnv = testEnv.Clone()

# Include the TES Common directory so that we can find xcp_server header files.
xcpServerDir = localEnv[ 'TES_COMMON_DIR' ] + '/apps/xcp_server/'

localEnv.Append(CPPPATH = [xcpServerDir + 'linux'])

sourceFiles = [
    'XcpServerTask.cpp',
    'xcpServerDb.cpp'
]

aisXcpServer = localEnv.Program(
        target = 'aisXcpServer',
        source = sourceFiles,
        LIBS = [ 'ais_task', 'xcp_server', 'bmi_ethernet_util' ]
    )

localEnv.InstallBinary(aisXcpServer)
