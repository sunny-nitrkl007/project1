Import( 'baseEnv' )
testEnv = baseEnv.Clone();

testEnv.Append(CCFLAGS = ['-Werror'])

Export( 'testEnv' )

appEnv = testEnv.Clone()
Export ( 'appEnv' )

if appEnv[ 'PLATFORM' ] in ['A6N1', 'A6N2']:
    appEnv.buildit( 'FileTransferBridgeApp', ['suse'] )

appEnv.buildit( 'VP3FileCreatorApp', ['suse'] )
appEnv.buildit( 'SwitchInputApp', ['suse'] )
appEnv.buildit( 'SerialPrinterApp', ['suse'] )
appEnv.buildit( 'xcp_server', ['suse'] )

# Target only apps
if (not appEnv[ 'PLATFORM' ] in [ 'x86_64-linux-gnu', 'OCS' ]):
    appEnv.buildit( 'bmiJ1939', ['suse'] )
    appEnv.buildit( 'bmiCdl', ['suse'] )
    # appEnv.buildit( 'BmiEthernet', ['suse'] ) # TODO: Update for platformCommon
    appEnv.buildit( 'PwmInputApp', ['suse'] )
    appEnv.buildit( 'OutputApp', ['suse'] )
    appEnv.buildit( 'RemotePrinterApp', ['suse'] )
    # appEnv.buildit( 'bmiJ1939Test', ['suse'] ) # TODO: Update for platformCommon


# Test apps
