#Change testEnv something meaningful for vp3 app.
Import( 'testEnv' )

bmiJ1939TestEnv = testEnv.Clone();

sourceFiles = [
    'BmiJ1939Test.cpp'
]

bmiJ1939Test = bmiJ1939TestEnv.ProgramWrapper(
        target = 'bmiJ1939Test',
        source = sourceFiles,
        LIBS = [ 'ais_task', 'ais_config', 'ais_log' ]
    )

bmiJ1939TestEnv.InstallBinary( bmiJ1939Test )


bmiJ1939TestEnv.Alias("bmiJ1939Test", "#bin/bmiJ1939Test")


