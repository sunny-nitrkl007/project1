#Change testEnv something meaningful for AppRegTest App.
Import( 'testEnv' )

AppRegTestEnv = testEnv.Clone();

sourceFiles = [
    'AppRegTest.cpp'
]

AppRegTest = AppRegTestEnv.ProgramWrapper(
        target = 'AppRegTest',
        source = sourceFiles,
        LIBS = [ 'ais_task', 'ais_config', 'ais_log' ]
    )

AppRegTestEnv.InstallBinary( AppRegTest )


AppRegTestEnv.Alias("AppRegTest", "#bin/AppRegTest")


