#Change testEnv something meaningful for bmi cdl.
Import( 'testEnv' )

bmiCdlEnv = testEnv.Clone();

## Enable below line for automation testing
##bmiCdlEnv.Append( CPPDEFINES=[ 'WRITE_AUTOMATION_DATA' ] )

#bmiCdlEnv.Append( LIBPATH = [ '#/sandbox/lib' ] )
#bmiCdlEnv.Append( CPPPATH = [ '#/sandbox/include' ] )

bmiCdlEnv.Append( CPPPATH = ['.',
                             '#/prod/common/interfaces/DataLinkData',
                            ] )

sourceFiles = [
    'BmiCdl.cpp',
    'app_cdl_mod_globals.c',
    'app_rtos_config_posix.c',
    'bmi_cdl_recv_main.c',
    'app_inits.c',
    'BmiCdlWrapper.cpp',
    'BmiCdlCfg.cpp',
    'BmiCdlUtil.cpp',
    'BmiCdlDiag.cpp'
    ]

if 'CPPDEFINES' in bmiCdlEnv.Dictionary().keys() and 'WRITE_AUTOMATION_DATA' in bmiCdlEnv[ 'CPPDEFINES' ]:
    sourceFiles.append('BmiCdlAutomation.cpp')

libList = [ 'ais_task', 'ais_config', 'ais_log','commTask',
                 'scl_util',
                 'cdl_', 'cdl2_', 'cdl2_pit',
                 'oel_u', 'oel_rtos_posix', 'oel_posix',
                 '_util'
              ]
# hal_init and hal_util not available in ssp-linux-is7 (A7H4)
if bmiCdlEnv['PLATFORM'] != 'A7H4':
    libList += ['hal_init', 'hal_util']

if (bmiCdlEnv[ 'PLATFORM' ] == "A6N2"):
    libList.append('hal_cdl_a6n2')
elif (bmiCdlEnv[ 'PLATFORM' ] == "A6N1"):
    libList.append('hal_cdl_a6n1')
else:
   print("Skipping BmiCdl: '{0}' is not a supported platform".format(bmiCdlEnv[ 'PLATFORM' ]))
   Return()

bmiCdl = bmiCdlEnv.ProgramWrapper(
        target = 'bmiCdl',
        source = sourceFiles,
        LIBS = libList,
    )

bmiCdlEnv.InstallBinary( bmiCdl )


bmiCdlEnv.Alias("bmiCdl", "#bin/bmiCdl")


