Import( 'appEnv' )

localEnv = appEnv.Clone()

localEnv.Append( CPPPATH = [ '#apps/xcp_server/linux', ] )

sourceFiles = [
    'XCPServer.c',
    'XCPServer_mem.c',
    'db/XCPServerDb.cpp',
    'linux/XCPHal.c',
]

aisXcpServer = localEnv.SharedLibraryWrapper(
        target = 'xcp_server',
        source = sourceFiles,
    )

localEnv.InstallLibrary(aisXcpServer)
