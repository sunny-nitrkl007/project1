Import( 'testEnv' )
 
sourceFiles = [ 
    'PwmInput.cpp'
]

PwmInput = testEnv.Program( 
        target = 'PwmInput',
        source = sourceFiles,
        LIBS = [ 'ais_task', 'ais_config', 'ais_log'] 

    )

testEnv.InstallBinary( PwmInput )
testEnv.Alias("PwmInput", "#bin/PwmInput")


