Import( 'testEnv' )

sourceFiles = [ 
    'VP3FileCreationApp.cpp'
]

VP3FileCreationApp = testEnv.ProgramWrapper( 
        target = 'VP3FileCreationApp',
        source = sourceFiles,
        LIBS = [ 'ais_task', 'ais_config', 'ais_log', 'ais_simpleComms' ]
    )

testEnv.InstallBinary( VP3FileCreationApp )

testEnv.Alias("VP3FileCreationApp", "#bin/VP3FileCreationApp")
