#Change testEnv something meaningful for vp3 app.
Import( 'testEnv' )

outputAppTestEnv = testEnv.Clone();

sourceFiles = [
    'OutputAppTest.cpp'
]

outputAppTest = outputAppTestEnv.ProgramWrapper(
        target = 'outputAppTest',
        source = sourceFiles,
        LIBS = [ 'ais_task', 'ais_config', 'ais_log' ]
    )

outputAppTestEnv.InstallBinary( outputAppTest )


outputAppTestEnv.Alias("outputAppTest", "#bin/outputAppTest")


