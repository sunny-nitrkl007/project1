import glob
import os

Import( 'testEnv' )
myEnv = testEnv.Clone()

TES_COMMON_ROOT = Dir('#').abspath
REPO_ROOT = os.path.abspath(os.path.join(TES_COMMON_ROOT, '..'))
WORKSPACE_ROOT = os.path.abspath(os.path.join(REPO_ROOT, '..'))
ROS2_MODELS_ROOT = os.path.join(WORKSPACE_ROOT, 'ros2_models', 'ros2_models')

ros2_libs = []
ros2_lib_dir = os.path.join(ROS2_MODELS_ROOT, 'lib')
for so in glob.glob(os.path.join(ros2_lib_dir, '*', 'lib*.so')):
    ros2_libs.append(os.path.basename(so)[3:-3])

for include_dir in glob.glob(os.path.join(WORKSPACE_ROOT, 'ros2_jazzy_sdk', 'include', '*')):
    if os.path.isdir(include_dir):
        myEnv.Append(CPPPATH=[include_dir])

myEnv.Append(CPPPATH=[
    os.path.join(ROS2_MODELS_ROOT, 'include'),
    os.path.join(REPO_ROOT, 'CPM-Loader-ais', 'prod', 'common', 'ros2wrapper'),
])

ROS_LIB_PATHS = [
    os.path.join(WORKSPACE_ROOT, 'ros2_jazzy_sdk', 'lib'),
    os.path.join(ROS2_MODELS_ROOT, 'lib', 'job_mgr_interfaces'),
]
myEnv.Append(LIBPATH=ROS_LIB_PATHS)
myEnv.Append(LINKFLAGS=[
    flag
    for path in ROS_LIB_PATHS
    for flag in ('-Wl,-rpath,' + path, '-Wl,-rpath-link,' + path)
])

base_libs = [
    'rclcpp', 'rcl', 'rcutils', 'rmw', 'rmw_implementation',
    'rcl_yaml_param_parser', 'rcl_logging_interface',
    'rcl_interfaces__rosidl_typesupport_cpp', 'rosidl_typesupport_cpp',
    'rosidl_runtime_c', 'tracetools', 'ament_index_cpp', 'rcpputils',
    File(os.path.join(WORKSPACE_ROOT, 'ros2_jazzy_sdk', 'lib', 'liblibstatistics_collector.so')),
    'statistics_msgs__rosidl_typesupport_cpp', 'rosgraph_msgs__rosidl_typesupport_cpp',
    'type_description_interfaces__rosidl_typesupport_c', 'std_msgs__rosidl_typesupport_cpp',
]

OutputTask = myEnv.Program(
    target='OutputApp',
    source=['OutputApp.cpp'],
    LIBS=base_libs + ros2_libs
)

testEnv.InstallBinary(OutputTask)
testEnv.InstallConfig(
    os.path.join(TES_COMMON_ROOT, 'ros2_config'),
    'OutputApp.yaml'
)
