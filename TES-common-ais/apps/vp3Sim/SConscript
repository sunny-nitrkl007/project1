#Change testEnv something meaningful for vp3 app.
Import( 'testEnv' )

vp3SimEnv = testEnv.Clone();

sourceFiles = [
    'Vp3Sim.cpp'
]

vp3Sim = vp3SimEnv.ProgramWrapper(
        target = 'vp3Sim',
        source = sourceFiles,
        LIBS = [ 'ais_task', 'ais_config', 'ais_log' ]
    )

vp3SimEnv.InstallBinary( vp3Sim )


vp3SimEnv.Alias("vp3Sim", "#bin/vp3Sim")


