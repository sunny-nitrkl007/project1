Import( 'infEnv' )

sourceFiles = [
    'EthernetPgtServer.cpp',
    'csf_pgt_server/config/src/csf_pgt_server_config.c',
    'scl_pdb/config/src/scl_pdb_tx_config.c',
]

infEnv.Append( CPPPATH = [
                           'csf_pgt_server/config/include',
                           'scl_pdb/config/include',
] )

EthernetPgtServer = infEnv.SharedLibraryWrapper(
    target='ethernetPgtServer',
    source=sourceFiles,
    # NOTE: LIBS need to be included by the app
)

infEnv.InstallLibrary( EthernetPgtServer )
