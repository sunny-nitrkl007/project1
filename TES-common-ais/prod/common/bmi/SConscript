Import( 'commonEnv' )

# Only build for ECM target, requires SCL headers
if ( commonEnv['PLATFORM'] in [ 'A6N1', 'A6N2', ]):
    # 1. bmi_ethernet_parser
    sourceFiles = [
        'bmi_ethernet_parser.cpp',
    ]

    bmi_ethernet_parser = commonEnv.SharedLibraryWrapper(
        target='bmi_ethernet_parser',
        source=sourceFiles,
        LIBS = [ 'ais_log', 'ais_config' ],
    )

    commonEnv.InstallLibrary( bmi_ethernet_parser )

# 2. bmi_ethernet_util
sourceFiles = [
    'bmi_ethernet_util.cpp',
]

bmi_ethernet_util = commonEnv.SharedLibraryWrapper(
    target='bmi_ethernet_util',
    source=sourceFiles,
    LIBS = [ 'ais_log', 'ais_config' ],
)

commonEnv.InstallLibrary( bmi_ethernet_util )
