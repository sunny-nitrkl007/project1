#!/usr/bin/python
Import( 'jhm2CommonEnv' )

jhm2RequestProc = jhm2CommonEnv.SharedLibraryWrapper(
        target = 'jhm2RequestProc',
        source = ['Jhm2RequestProcessor.cpp'],
        LIBS = ['ais_config', 'ais_log', 'ais_serialization', jhm2CommonEnv['BOOST_SERIALIZATION']]
    )

jhm2CommonEnv.InstallLibrary( jhm2RequestProc )

