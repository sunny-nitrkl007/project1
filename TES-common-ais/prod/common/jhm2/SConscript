Import( 'commonEnv' )
jhm2CommonEnv = commonEnv.Clone();
Export( 'jhm2CommonEnv' )

jhm2CommonEnv.buildit( 'jhm2CgiApp', ['suse'] )
jhm2CommonEnv.buildit( 'Jhm2RequestProcessor', ['suse'] )
jhm2CommonEnv.buildit( 'Jhm2Ipc', ['suse'] )
jhm2CommonEnv.buildit( 'Jhm2RequestBuilder', ['suse'] )
