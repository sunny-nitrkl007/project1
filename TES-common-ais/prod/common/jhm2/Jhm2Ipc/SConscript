#!/usr/bin/python
Import( 'jhm2CommonEnv' )

jhm2IpcServer = jhm2CommonEnv.SharedLibraryWrapper(
        target = 'jhm2IpcServer',
        source = ['Jhm2IpcServer.cpp'],
        LIBS = ['ais_log']
    )

jhm2IpcClient = jhm2CommonEnv.SharedLibraryWrapper(
        target = 'jhm2IpcClient',
        source = ['Jhm2IpcClient.cpp'],
        LIBS = ['ais_log']
    )

jhm2CommonEnv.InstallLibrary( jhm2IpcServer )
jhm2CommonEnv.InstallLibrary( jhm2IpcClient )

