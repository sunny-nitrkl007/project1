<?xml version="1.0" encoding="UTF-8"?>
<!-- Note that this file must be named ivy.xml in a module -->
<ivy-module version="2.0" xmlns:e="http://ant.apache.org/ivy/extra" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://ant.apache.org/ivy/schemas/ivy.xsd">
    <!-- Replace this information with specific module information -->
    <info organisation="org" module="mod" revision="rev" status="integration" publication="20130715155206" e:ivydom="dom"/>
    <!-- Configurations defined for this module. Please do not make up new
         configurations. Copy the desired configurations from the ivyutils
         file named, "common-conf.xml". If new configurations are necessary,
         consult with the Ivy Utility team. 
         
         Supported Configuration Descriptions:
         rel: The rel configuration contains all of the dependencies that the 
              release unit had at the time of the release.
         nodep: The nodep configuration contains the dependecies of this release
              unit without dependencies to any other release unit.
         dev: The dev configuration contains the dependecies of this release
              unit plus any dependencies to build this release unit.
    -->
    <configurations defaultconf="rel">
        <conf description="retrieve artifacts necessary to use the module" name="rel"/>
        <conf description="retrieve artifacts that are part of this release unit" name="nodep"/>
        <conf description="retrieve artifacts needed to build this release unit" name="dev"/>
    </configurations>
    <!-- Publications defines what artifacts are included with this module
         Note, there must be a publications section or a single artifact is
         assumed named <module>.jar. Thus, if no artifacts are needed,
         create an empty publications block. 

         The artifact described below does not specify a configuration.  This 
         makes the artifact applicable to all configurations.
    -->
    <publications>
        <artifact ext="xml" name="git-repo" type="git"/>
    </publications>
    <!-- Define any dependencies for this module. Note, "*->@" means map all module
         configurations to equally named configurations for the dependency. -->
    <dependencies defaultconf="*->@">
    </dependencies>
</ivy-module>
