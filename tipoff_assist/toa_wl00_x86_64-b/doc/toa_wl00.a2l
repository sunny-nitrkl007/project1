          /end XCP_ON_UDP_IP
    /end IF_DATA


    /begin IF_DATA ASAP1B_CCP

        /begin RASTER
            "CCP_UPDATE BaseRate" "BaseRate" 0 3 30
        /end RASTER
        /begin TP_BLOB
            /* CCP Version                              */  0x210
            /* Blob Version                             */  0x0204
            /* CAN-Message ID for 'Transmitting to ECU' */  0x82010000
            /* CAN-Message ID for 'Receiving from ECU'  */  0x82020000
            /* Logical CCP-Address of the ECU (station) */  0x0
            /* Endianess / Byte order                   */  2
            BAUDRATE                                        250000
        /end TP_BLOB
    /end IF_DATA
		




