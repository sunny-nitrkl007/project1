               ulong;  /* Base address of the online data   */
               ulong;  /* Number of Bytes belonging to the online data (1,2 or 4) */
               taggedstruct {
                  ("RASTER" uchar )*;
                         /* Array of event channel initialization values */
               };
            };
        };

