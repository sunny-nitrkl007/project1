    eml {
      isEML		      1
      script		      "function lowPassFilterFactor = calcFilterFactor(timestep, lowPassFilterCutoffHz)\n\n% Low-pass fi"
      "lter cutoff (rad/s)\ncutoff = lowPassFilterCutoffHz * (2 * pi);\n% Low-pass filter angle (rad)\nangle = cutoff *"
      " timestep;\n% Filter factor corresponding to cutoff\nlowPassFilterFactor = ...\n    (cos(angle) - 1) + sqrt((cos"
      "(angle) - 3) * (cos(angle) - 1));\n"
      editorLayout	      "100 M4x1[10 5 700 500]"
    }
  }
