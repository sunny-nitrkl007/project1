  state {
    id			    50
    labelString		    "eML_blk_kernel()"
    position		    [18 64.5 118 66]
    fontSize		    12
    chart		    49
    treeNode		    [49 0 0 0]
    superState		    SUBCHART
    subviewer		    49
    ssIdNumber		    1
    type		    FUNC_STATE
    decomposition	    CLUSTER_STATE
    eml {
      isEML		      1
      script		      "function status = securePfwStatus(inputsBad, latched, measCondOk, secureAssumed)\n\nif inputsBad\n"
      "    status = TipAssistSecPfwStatus_t.FAULT;\nelseif latched && measCondOk && secureAssumed\n    % Let consumers "
      "know that PFW is valid and may improve in confidence\n    status = TipAssistSecPfwStatus_t.VALID_MEASURING;\nels"
      "eif latched && ~measCondOk && secureAssumed\n    % Let consumers know that PFW is valid, but won't improve in co"
      "nfidence\n    status = TipAssistSecPfwStatus_t.VALID_NOT_MEASURING;\nelseif ~latched && measCondOk && secureAssu"
      "med\n    % Let consumers know that PFW is likely about to become valid\n    status = TipAssistSecPfwStatus_t.PEN"
      "DING;\nelse\n    status = TipAssistSecPfwStatus_t.INVALID;\nend\n"
      editorLayout	      "100 M4x1[10 5 700 500]"
    }
  }
