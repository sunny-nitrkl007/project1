  chart {
    id			    246
    machine		    1
    name		    "Tip-Off Assist Support Lib/Tip-Off Assist Payload/Pseudo-Frictionless Weigh/Statistics Estimation2/MATL"
    "AB Function"
    windowPosition	    [357.12 483.496 167 391]
    viewLimits		    [0 156.75 0 153.75]
    screen		    [1 1 1280 1024 1.041666666666667]
    treeNode		    [0 247 0 0]
    viewObj		    246
    ssIdHighWaterMark	    10
    decomposition	    CLUSTER_CHART
    type		    EML_CHART
