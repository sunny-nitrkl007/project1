  state {
    id			    414
    labelString		    "eML_blk_kernel()"
    position		    [18 64.5 118 66]
    fontSize		    12
    chart		    413
    treeNode		    [413 0 0 0]
    superState		    SUBCHART
    subviewer		    413
    ssIdNumber		    1
    type		    FUNC_STATE
    decomposition	    CLUSTER_STATE
    eml {
      isEML		      1
      script		      "function compPress = fcn(rawPress, liftCmd, fricCoeff, fricOffset)\n% rawPress\n%   Equivalent HE"
      " pressure in kPa\n% liftCmd\n%   Lift command with\n% fricCoeff\n%   Friction coefficient in units of kPa of fri"
      "ction / raw kPa\n% fricOffset\n%   Friction offset in units of kPa\n\nif liftCmd < 0.0        % Lower\n    compP"
      "ress = (1 + fricCoeff) * rawPress + fricOffset;\nelseif liftCmd == 0.0   % Hold\n    compPress = rawPress;\nelse"
      "if liftCmd > 0.0    % Raise\n    compPress = (1 - fricCoeff) * rawPress - fricOffset;\nelse\n    % Unexpected, s"
      "o propogate value that triggers bad status\n    compPress = single(NaN);\nend\n"
      editorLayout	      "100 M4x1[10 5 700 500]"
    }
  }
