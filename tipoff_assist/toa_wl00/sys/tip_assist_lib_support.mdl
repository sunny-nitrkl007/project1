		    ZOrder		    13489
		    IconDisplay		    "Port number"
		    }
		    Line {
		    ZOrder		    1
		    SrcBlock		    "reset"
		    SrcPort		    1
		    DstBlock		    "MATLAB Function"
		    DstPort		    2
		    }
		    Line {
		    ZOrder		    2
		    SrcBlock		    "in"
		    SrcPort		    1
		    DstBlock		    "MATLAB Function"
		    DstPort		    1
		    }
		    Line {
		    ZOrder		    3
		    SrcBlock		    "MATLAB Function"
		    SrcPort		    1
		    DstBlock		    "out"
		    DstPort		    1
		    }
		    Annotation {
		    SID			    "844"
		    Name		    "Per Aaron Shatters:\nThis filter was added to PCS (the CPM predecessor) because pump piston pass freq"
		    "uency was aliasing into the signal.  Being kind of like a discrete derivative, the variance calculation is sensi"
		    "tive to high frequency noise.  So this filter was added to prevent the high frequency instances of this noise.  "
		    "Being a two sample moving average, it is the fastest filter that eliminated the noise.  It was not thoroughly te"
		    "chnically examined, but it worked.  It's not clear the extent to which this is necessary here, since Pseudo-Fric"
		    "tionless Weigh works only when the tilt and lift valve command is zero, so the pump should not be hydraulically "
		    "connected to the cylinder at this time.  The pump is also likely to be at a low stroke, so piston pass ripple am"
		    "plitude should be low."
		    Position		    [-82, 98, 297, 234]
		    InternalMargins	    [0, 0, 0, 0]
		    FixedHeight		    on
		    FixedWidth		    on
		    ZOrder		    -1
		    }
		  }
		}
