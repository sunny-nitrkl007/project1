    eml {
      isEML		      1
      script		      "function [outPayload, outStatus]= sendCpmStatus(pfwStatus, pfwPayload, pfwIsPrecise, liveStatus, "
      "livePayload)\n\nif pfwIsPrecise && (pfwStatus == TipAssistSecPfwStatus_t.VALID_MEASURING || pfwStatus == TipAssi"
      "stSecPfwStatus_t.VALID_NOT_MEASURING)\n	outStatus = TipAssistSendCpmStatus_t.PSEUDO_FRICTIONLESS;\n    outPayloa"
      "d = pfwPayload;\nelseif liveStatus == TipAssistLiveWeighStatus_t.VALID\n    outStatus = TipAssistSendCpmStatus_t"
      ".LIVE;\n    outPayload = livePayload;\nelse\n    outStatus = TipAssistSendCpmStatus_t.INVALID;\n    outPayload ="
      " single(NaN);\nend\n"
      editorLayout	      "100 M4x1[10 5 700 500]"
    }
  }
