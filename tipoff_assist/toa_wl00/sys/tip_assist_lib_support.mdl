  state {
    id			    275
    labelString		    "eML_blk_kernel()"
    position		    [18 64.5 118 66]
    fontSize		    12
    chart		    274
    treeNode		    [274 0 0 0]
    superState		    SUBCHART
    subviewer		    274
    ssIdNumber		    1
    type		    FUNC_STATE
    decomposition	    CLUSTER_STATE
    eml {
      isEML		      1
      script		      "function status = unsecurePfwStatus(inputsBad, warm, measCondOk)\n\nif inputsBad\n    status = Ti"
      "pAssistUnsecPfwStatus_t.FAULT;\nelseif warm && measCondOk\n    % Let consumers know that PFW is valid and may im"
      "prove in confidence\n    status = TipAssistUnsecPfwStatus_t.VALID;\nelseif ~warm && measCondOk\n    % Let consum"
      "ers know that PFW is likely about to become valid\n    status = TipAssistUnsecPfwStatus_t.PENDING;\nelse\n    st"
      "atus = TipAssistUnsecPfwStatus_t.INVALID;\nend\n"
      editorLayout	      "100 M4x1[10 5 700 500]"
    }
  }
