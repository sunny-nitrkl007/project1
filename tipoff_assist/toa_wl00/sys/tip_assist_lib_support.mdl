		  SID			  "527"
		  Ports			  [1, 1]
		  Position		  [265, 190, 325, 220]
		  ZOrder		  13569
		  LibraryVersion	  "1.401"
		  SourceBlock		  "simulink/Logic and Bit\nOperations/Detect\nDecrease"
		  SourceType		  "Detect Decrease"
		  SourceProductName	  "Simulink"
		  SourceProductBaseCode	  "SL"
		  ContentPreviewEnabled	  off
		  vinit			  "0"
		  InputProcessing	  "Elements as channels (sample based)"
		  OutDataTypeStr	  "boolean"
		}
		Block {
		  BlockType		  SubSystem
		  Name			  "Resettable Discrete Derivative"
		  SID			  "644"
		  Ports			  [2, 1]
		  Position		  [760, -117, 855, -53]
		  ZOrder		  13586
		  RequestExecContextInheritance	off
		  Variant		  off
		  Object {
		    $PropName		    "MaskObject"
		    $ObjectID		    32
		    $ClassName		    "Simulink.Mask"
		    Type		    "Discrete Derivative"
		    Description		    "Simulink:masks:DiscreteDerivative_MD"
		    Initialization	    "\nblkH = gcbh;\nblkName = getfullname(blkH);\n\nif (gainval == 0.0)\n    %avoid divide by ze"
		    "ro warning\n    inverseGainval = inf;\nelse\n    inverseGainval = 1.0/double(gainval);\nend\n\nif isequal(OutDat"
		    "aTypeStr, 'Inherit: Inherit via internal rule')\n    diffDT   = 'Inherit: Inherit via back propagation';\n    ts"
		    "ampDT  = 'Inherit: Inherit via internal rule';\n    tsampImp = 'Offline Scaling Adjustment';\nelse    \n    diff"
		    "DT   = OutDataTypeStr;\n    tsampDT  = 'Inherit: Inherit via back propagation';\n    tsampImp = 'Online Calculat"
		    "ions';\nend\n\nif ~strcmp(get_param(bdroot(blkH),'SimulationStatus'), 'running')\n    set_param([blkName,'/Diff'"
		    "], ...\n              'RndMeth',RndMeth, ...\n	          'DoSatur',DoSatur);\n    set_param([blkName,'/TSamp'], "
		    "...\n              'OutDataTypeStr',tsampDT, ...\n              'RndMeth',RndMeth, ...\n              'DoSatur',"
		    "DoSatur, ...\n              'TsampMathImp',tsampImp);\nend\n\nset_param([blkName,'/Resettable Delay'], ...\n	'In"
		    "putProcessing',InputProcessing);\n"
		    SelfModifiable	    "on"
		    Display		    "text(0.5, 0.5, 'K (z-1)', 'horizontalAlignment', 'center', 'verticalAlignment', 'bottom');text(0.5"
		    ", 0.5, 'Ts z', 'horizontalAlignment', 'center', 'verticalAlignment', 'top');plot([0.3 0.7],[0.5 0.5]);"
		    IconOpaque		    "opaque-with-ports"
		    RunInitForIconRedraw    "off"
		    IconUnits		    "normalized"
		    Capabilities	    "slmaskedcaps(gcbh)"
		    Array {
		    Type		    "Simulink.MaskParameter"
		    Dimension		    11
		    Object {
		    $ObjectID		    33
		    Type		    "edit"
		    Name		    "gainval"
		    Prompt		    "Simulink:masks:GainValue_MP"
		    Value		    "1"
		    Tunable		    "off"
		    }
		    Object {
		    $ObjectID		    34
		    Type		    "popup"
		    Array {
		    Type		    "Cell"
		    Dimension		    3
		    Cell		    "Simulink:masks:ColumnsAsChannelsFrameBased"
		    Cell		    "Simulink:masks:ElementsAsChannelsSampleBased"
		    Cell		    "Simulink:masks:Inherited"
		    PropName		    "TypeOptions"
		    }
		    Name		    "InputProcessing"
		    Prompt		    "Simulink:masks:InputProcessing_MP"
		    Value		    "Inherited"
		    Evaluate		    "off"
		    Tunable		    "off"
		    }
		    Object {
		    $ObjectID		    35
		    Type		    "min"
		    Name		    "OutMin"
		    Prompt		    "Simulink:masks:OutputMinimum_MP"
		    Value		    "[]"
		    Tunable		    "off"
		    }
		    Object {
		    $ObjectID		    36
		    Type		    "max"
		    Name		    "OutMax"
		    Prompt		    "Simulink:masks:OutputMaximum_MP"
		    Value		    "[]"
		    Tunable		    "off"
		    }
		    Object {
		    $ObjectID		    37
		    Type		    "unidt({m=5|6|7||8|3|4|}{i=Inherit: Inherit via internal rule|Inherit: Inherit via back propagation}{b"
		    "=double|single|int8|uint8|int16|uint16|int32|uint32}{s=UDTBinaryPointMode|UDTSlopeBiasMode|UDTBestPrecisionMode}"
		    "{g=UDTSignedSign|UDTUnsignedSign})"
