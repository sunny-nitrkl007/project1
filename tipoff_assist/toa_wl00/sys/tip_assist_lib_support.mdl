  chart {
    id			    21
    machine		    1
    name		    "Tip-Off Assist Support Lib/Tip-Off Assist Payload/Pseudo-Frictionless Weigh/Weighing Statistics, Secure"
    " Latched/One Sided Confidence Limit"
    windowPosition	    [422 539.941 189 413]
    viewLimits		    [0 156.75 0 153.75]
    screen		    [1 1 3600 1200 1.180555555555556]
    treeNode		    [0 22 0 0]
    viewObj		    21
    ssIdHighWaterMark	    6
    decomposition	    CLUSTER_CHART
    type		    EML_CHART
    chartFileNumber	    3
    disableImplicitCasting  1
    eml {
      name		      "oneSidedConfBound"
    }
    firstData		    23
    firstTransition	    27
    firstJunction	    26
  }
  state {
    id			    22
    labelString		    "eML_blk_kernel()"
    position		    [18 64.5 118 66]
    fontSize		    12
    chart		    21
    treeNode		    [21 0 0 0]
    superState		    SUBCHART
    subviewer		    21
    ssIdNumber		    1
    type		    FUNC_STATE
    decomposition	    CLUSTER_STATE
    eml {
      isEML		      1
      script		      "function bound = oneSidedConfBound(confidence, stdev)\n% Calculates the size of a confidence inte"
      "rval in terms of half its width.\n%\n% Inputs:\n%   confidence\n%   Confidence that the resulting bound will enc"
      "lose the true value.\n%\n%   stdev\n%   The observed standard deviation, expressed in the same units as\n%   bou"
      "nd. Can be thought of as defining the scale of the normal\n%   distribution that we are assuming represents the "
      "data we are sampling.\n%\n%   Potential units for the arguments are percent of rated payload or\n%   payload.\n%"
      "\n% Outputs:\n%   bound\n%   Bound of the confidence interval, expressed in the same units as stdev.\n%   \n%   "
      "For lower bound, the true value will lie above the mean minus this\n%   value.\n%   The opposite is true for an "
      "upper bound.\n%   \n% Inspired from pcs_calculate_confidence() in pcs_io.c\n\n% Table of confidence vs one-sided"
      " confidence interval bound.\n% Units of confidence decimal percent and the ratio of standard\n% deviation of a s"
      "tandard normal distribution.\nxConfidenceOneSided = [0.500000000000000,0.617911422000000,0.691462461000000,0.758"
      "036347000000,0.815939873500000,0.864333838000000,0.903199463500000,0.933192771500000,0.955434528500000,0.9712834"
      "36000000,0.982135576500000,0.989275889000000,0.993790334000000,0.996533026000000,0.998650102000000,0.99976737100"
      "0000,1];\nyStdevRatio = [ 0.0, 0.3, 0.5, 0.7, 0.9, 1.1, 1.3, 1.5, 1.7, 1.9, 2.1, 2.3, 2.5, 2.7, 3.0, 3.5, 4.0 ];"
      "\nstdev_ratio = interp1(xConfidenceOneSided, yStdevRatio, confidence);\nbound = stdev_ratio * stdev;"
      editorLayout	      "100 M4x1[10 5 700 500]"
