      script		      "function y = movingAverage(u, reset)\n\npersistent lastSample\nif isempty(lastSample) || reset\n "
      "   lastSample = single(u);\nend\ny = (u + lastSample) / 2;\nlastSample = u;\n"
      editorLayout	      "100 M4x1[10 5 700 500]"
    }
  }
