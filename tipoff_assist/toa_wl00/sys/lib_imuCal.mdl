  chart {
    id			    82
    machine		    1
    name		    "imuCal Subsystem/TOA Weight Simulink Function/EEF IMU to NEEF gravity vector/euler angles from rot matr"
    "ix"
    windowPosition	    [422 539.941 189 413]
    viewLimits		    [0 156.75 0 153.75]
    screen		    [1 1 3600 1200 1.180555555555556]
    treeNode		    [0 83 0 0]
    viewObj		    82
    toolbarMode		    LIBRARY_TOOLBAR
    ssIdHighWaterMark	    9
    decomposition	    CLUSTER_CHART
    type		    EML_CHART
    chartFileNumber	    10
    disableImplicitCasting  1
    eml {
      name		      "decomp"
    }
    firstData		    84
    firstTransition	    87
    firstJunction	    86
  }
  state {
    id			    83
    labelString		    "eML_blk_kernel()"
    position		    [18 64.5 118 66]
    fontSize		    12
    chart		    82
    treeNode		    [82 0 0 0]
    superState		    SUBCHART
    subviewer		    82
    ssIdNumber		    1
    type		    FUNC_STATE
    decomposition	    CLUSTER_STATE
    eml {
      isEML		      1
      script		      "function rotations  = decomp(rotMatrix)\n%   Input:  3x3 rotation matrix\n%   Output: 1x3 vector "
      "of euler angles in degrees\nrotations = zeros(1,3);\nrotations(1) = atan2(rotMatrix(3,2),rotMatrix(3,3));\nrotat"
      "ions(2) = atan2(-rotMatrix(3,1), (sqrt((rotMatrix(3,2)^2)+(rotMatrix(3,3)^2))));\nrotations(3) = atan2(rotMatrix"
      "(2,1),rotMatrix(1,1));\n% convert back to degrees\nfor i=1:size(rotations,2)\n    rotations(i) = 180*rotations(i"
      ")/pi;\nend\nend"
      editorLayout	      "100 M4x1[10 5 700 500]"
    }
  }
