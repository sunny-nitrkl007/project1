  state {
    id			    56
    labelString		    "eML_blk_kernel()"
    position		    [18 64.5 118 66]
    fontSize		    12
    chart		    55
    treeNode		    [55 0 0 0]
    superState		    SUBCHART
    subviewer		    55
    ssIdNumber		    1
    type		    FUNC_STATE
    decomposition	    CLUSTER_STATE
    eml {
      isEML		      1
      script		      "function [pitchOffset, lumpedWeight] = imuCal(...\n    resetLowerFlag, resetRaiseFlag, calDirecti"
      "onFlag, getPitchOffsetFlag, ...\n    liftHeight, tiltHePress, tiltRePress, liftPress, ...\n    imuX, imuY, imuZ,"
      " ...\n    liftAngle, tiltExt, steerAngle, ...\n    toa_appNumber, toa_tiltBoreDia, toa_tiltRodDia, toa_liftBoreD"
      "ia, toa_tiltNumCyl, toa_toolBcLength)\n% IMUCAL Calibrate IMU\n%\n% Collects data during CPM calibration and cal"
      "culates an IMU pitch offset\n% calibration value.\n%\n% Data is collected between the *_TRIGGER_HEIGHT lift heig"
      "hts during the\n% slow loaded raise and slow loaded lower portion of the CPM cal.  Then, a\n% brute force search"
      " for the correct IMU pitch cal value begins.  For\n% candidate pitch values (which are an input into the TOA wei"
      "ghing math,\n% the following occurs.\n%\n% Tip-Off Assist weighing math is applied to obtain a corresponding wei"
      "ght\n% signal for both raise a lower.  The signals include friction.  A\n% phaseless notch filter is applied to "
      "the weight signals to remove machine\n% resonance. The raise and lower weight signals are then sampled at the\n%"
      " lift angles specified by *_LA_SLOPE_POINTS.  The weights at the sample\n% points are averaged to produce a fric"
      "tionless weight at each lift angle.\n% Finally, the slope of the lift angle vs. frictionless weight curve is\n% "
      "calculated.\n%\n% The correct IMU pitch cal value will be the one whose corresponding slope\n% is closest to zer"
      "o, because the correct cal value should produce the same\n% weight across the lift range.\n\n% To enable some co"
      "de paths that may be useful for development.\nDEBUG = false;\n\n% Sample time\n% Important for phaseless filteri"
      "ng\nTs = single(0.020);\n\n% Constants\n% Slope points a grid of lift angles (in degrees) that we sample the\n% "
      "time-series data to for purposes of calculating slope efficiently.  This\n% is done after phaseless filtering.\n"
      "LA_SLOPE_POINTS_BOTTOM = -10;   % MUST be higher than BOTTOM_TRIGGER_HEIGHT\nLA_SLOPE_POINTS_TOP = 15;       % M"
      "UST be lower than TOP_TRIGGER_HEIGHT\nLA_SLOPE_POINTS_INC = 0.5;\nLA_SLOPE_POINTS_NUM = (LA_SLOPE_POINTS_TOP - L"
      "A_SLOPE_POINTS_BOTTOM) / LA_SLOPE_POINTS_INC + 1;\nLA_SLOPE_POINTS_IDX_NEW = zeros(1, LA_SLOPE_POINTS_NUM);\nRAI"
      "SE_LA_SLOPE_POINTS = LA_SLOPE_POINTS_BOTTOM : LA_SLOPE_POINTS_INC : LA_SLOPE_POINTS_TOP;\nLOWER_LA_SLOPE_POINTS "
      "= LA_SLOPE_POINTS_TOP : -LA_SLOPE_POINTS_INC : LA_SLOPE_POINTS_BOTTOM;\nBOTTOM_TRIGGER_HEIGHT = 35; % MUST be lo"
      "wer than LA_SLOPE_POINTS_BOTTOM\nTOP_TRIGGER_HEIGHT = 80;    % MUST be heigher than LA_SLOPE_POINTS_TOP\nRAISE_S"
      "TART_HEIGHT = BOTTOM_TRIGGER_HEIGHT;\nRAISE_END_HEIGHT = TOP_TRIGGER_HEIGHT;\nLOWER_START_HEIGHT = TOP_TRIGGER_H"
      "EIGHT;\nLOWER_END_HEIGHT = BOTTOM_TRIGGER_HEIGHT;\nMAX_CAPTURE_TIME = 55;  % seconds per raise or lower\nBUFFER_"
      "LEN = MAX_CAPTURE_TIME / Ts;\nNEW_BUFFER = single(zeros(1, BUFFER_LEN));\nSEARCH_MIN = single(-8);\nSEARCH_MAX ="
      " single(8);\nSEARCH_INCREMENT = single(0.1);\nSEARCH_SPACE_SIZE = (SEARCH_MAX - SEARCH_MIN) / SEARCH_INCREMENT +"
      " 1;\nSEARCH_PITCH_OFFSETS = SEARCH_MIN : SEARCH_INCREMENT : SEARCH_MAX;\n\n% Variables that will persist across "
      "function calls\npersistent initialized\n\npersistent lowerStarted\npersistent lowerDone\npersistent lowerFailed\n"
      "persistent lowerBufferIdx\npersistent lowerLaSlopePointsDone\npersistent lowerLaSlopePointsIdxs\npersistent lowe"
      "rLaSlopePointsIdx\npersistent lowerBufTiltHePress\npersistent lowerBufTiltRePress\npersistent lowerBufLiftPress\n"
      "persistent lowerBufImuX\npersistent lowerBufImuY\npersistent lowerBufImuZ\npersistent lowerBufLiftAngle\npersist"
      "ent lowerBufTiltExt\npersistent lowerBufSteerAngle\n\npersistent raiseStarted\npersistent raiseDone\npersistent "
      "raiseFailed\npersistent raiseBufferIdx\npersistent raiseLaSlopePointsDone\npersistent raiseLaSlopePointsIdxs\npe"
      "rsistent raiseLaSlopePointsIdx\npersistent raiseBufTiltHePress\npersistent raiseBufTiltRePress\npersistent raise"
      "BufLiftPress\npersistent raiseBufImuX\npersistent raiseBufImuY\npersistent raiseBufImuZ\npersistent raiseBufLift"
      "Angle\npersistent raiseBufTiltExt\npersistent raiseBufSteerAngle\n\n% Initialize persistent variables\nif isempt"
      "y(initialized)\n    initialized = 1;\n    % Raise\n    raiseStarted = false;\n    raiseDone = false;\n    raiseF"
      "ailed = false;\n    raiseBufferIdx = 0;\n    raiseLaSlopePointsDone = false;\n    raiseLaSlopePointsIdxs = LA_SL"
      "OPE_POINTS_IDX_NEW;\n    raiseLaSlopePointsIdx = 1;\n    raiseBufTiltHePress = NEW_BUFFER;\n    raiseBufTiltRePr"
      "ess = NEW_BUFFER;\n    raiseBufLiftPress = NEW_BUFFER;\n    raiseBufImuX = NEW_BUFFER;\n    raiseBufImuY = NEW_B"
      "UFFER;\n    raiseBufImuZ = NEW_BUFFER;\n    raiseBufLiftAngle = NEW_BUFFER;\n    raiseBufTiltExt = NEW_BUFFER;\n"
      "    raiseBufSteerAngle = NEW_BUFFER;\n    % Lower\n    lowerStarted = false;\n    lowerDone = false;\n    lowerF"
      "ailed = false;\n    lowerBufferIdx = 0;\n    lowerLaSlopePointsDone = false;\n    lowerLaSlopePointsIdxs = LA_SL"
      "OPE_POINTS_IDX_NEW;\n    lowerLaSlopePointsIdx = 1;\n    lowerBufTiltHePress = NEW_BUFFER;\n    lowerBufTiltRePr"
      "ess = NEW_BUFFER;\n    lowerBufLiftPress = NEW_BUFFER;\n    lowerBufImuX = NEW_BUFFER;\n    lowerBufImuY = NEW_B"
      "UFFER;\n    lowerBufImuZ = NEW_BUFFER;\n    lowerBufLiftAngle = NEW_BUFFER;\n    lowerBufTiltExt = NEW_BUFFER;\n"
      "    lowerBufSteerAngle = NEW_BUFFER;\n\nend\n\n% Reset procedure\nif resetLowerFlag || resetRaiseFlag\n    fprin"
      "tf('# RESET - imuCal() called with arguments:\\n')\n    fprintf('## resetLowerFlag = %u\\n', uint8(resetLowerFla"
      "g))\n    fprintf('## resetRaiseFlag = %u\\n', uint8(resetRaiseFlag))\n    fprintf('## calDirectionFlag = %u\\n',"
      " uint8(calDirectionFlag))\n    fprintf('## getPitchOffsetFlag = %u\\n', uint8(getPitchOffsetFlag))\n    if reset"
      "LowerFlag\n        lowerStarted = false;\n        lowerDone = false;\n        lowerFailed = false;\n        lowe"
      "rBufferIdx = 0;\n        lowerLaSlopePointsDone = false;\n        lowerLaSlopePointsIdxs = LA_SLOPE_POINTS_IDX_N"
      "EW;\n        lowerLaSlopePointsIdx = 1;\n        lowerBufTiltHePress = NEW_BUFFER;\n        lowerBufTiltRePress "
      "= NEW_BUFFER;\n        lowerBufLiftPress = NEW_BUFFER;\n        lowerBufImuX = NEW_BUFFER;\n        lowerBufImuY"
      " = NEW_BUFFER;\n        lowerBufImuZ = NEW_BUFFER;\n        lowerBufLiftAngle = NEW_BUFFER;\n        lowerBufTil"
      "tExt = NEW_BUFFER;\n        lowerBufSteerAngle = NEW_BUFFER;\n    end\n    if resetRaiseFlag\n        raiseStart"
      "ed = false;\n        raiseDone = false;\n        raiseFailed = false;\n        raiseBufferIdx = 0;\n        rais"
      "eLaSlopePointsDone = false;\n        raiseLaSlopePointsIdxs = LA_SLOPE_POINTS_IDX_NEW;\n        raiseLaSlopePoin"
      "tsIdx = 1;\n        raiseBufTiltHePress = NEW_BUFFER;\n        raiseBufTiltRePress = NEW_BUFFER;\n        raiseB"
      "ufLiftPress = NEW_BUFFER;\n        raiseBufImuX = NEW_BUFFER;\n        raiseBufImuY = NEW_BUFFER;\n        raise"
      "BufImuZ = NEW_BUFFER;\n        raiseBufLiftAngle = NEW_BUFFER;\n        raiseBufTiltExt = NEW_BUFFER;\n        r"
      "aiseBufSteerAngle = NEW_BUFFER;\n    end\n    pitchOffset = single(NaN);\n    lumpedWeight = single(NaN);\n    r"
      "eturn\nend\n\n% Pitch Calibration Procedure\n% Brute-force search for flattest height vs. weight curve\nif getPi"
      "tchOffsetFlag\n    fprintf('# GET OFFSET - imuCal() called with arguments:\\n')\n    fprintf('## resetLowerFlag "
      "= %u\\n', uint8(resetLowerFlag))\n    fprintf('## resetRaiseFlag = %u\\n', uint8(resetRaiseFlag))\n    fprintf('"
      "## calDirectionFlag = %u\\n', uint8(calDirectionFlag))\n    fprintf('## getPitchOffsetFlag = %u\\n', uint8(getPi"
      "tchOffsetFlag))\n    fprintf('### RAISE\\n')\n    fprintf('#### raiseBufferIdx = %u\\n', uint8(raiseBufferIdx))\n"
      "    fprintf('#### raiseFailed = %u\\n', uint8(raiseFailed))\n    fprintf('#### raiseStarted = %u\\n', uint8(rais"
      "eStarted))\n    fprintf('#### raiseDone = %u\\n', uint8(raiseDone))\n    fprintf('#### lift angle min = %.1f, ma"
      "x = %.1f\\n', min(raiseBufLiftAngle), max(raiseBufLiftAngle))\n    fprintf('### LOWER\\n')\n    fprintf('#### lo"
      "werBufferIdx = %u\\n', uint8(lowerBufferIdx))\n    fprintf('#### lowerFailed = %u\\n', uint8(lowerFailed))\n    "
      "fprintf('#### lowerStarted = %u\\n', uint8(lowerStarted))\n    fprintf('#### lowerDone = %u\\n', uint8(lowerDone"
      "))\n    fprintf('#### lift angle min = %.1f, max = %.1f\\n', min(lowerBufLiftAngle), max(lowerBufLiftAngle))\n  "
      "  if raiseFailed || lowerFailed\n        pitchOffset = single(NaN);\n        lumpedWeight = single(NaN);\n      "
      "  fprintf('Raise or lower failed.  getPitchOffset not possible.')\n        return\n    end\n    % Allocate buffe"
      "rs of brute-force search calculated weights\n    searchRaiseSlopes = zeros(SEARCH_SPACE_SIZE, 1);\n    searchLow"
      "erSlopes = zeros(SEARCH_SPACE_SIZE, 1);\n    searchNoFricSlopes = zeros(SEARCH_SPACE_SIZE, 1);\n    searchLeastS"
      "lope = single(9999);\n    searchLeastSlopeIdx = single(999999);\n    searchLeastSlopePitchOffset = single(NaN);\n"
      "    searchLeastSlopeLumpedWeight = single(NaN);\n    for searchIdx = 1:SEARCH_SPACE_SIZE\n        searchPitchOff"
      "set = SEARCH_PITCH_OFFSETS(searchIdx);\n        if DEBUG\n            if raiseDone\n                searchRaiseS"
      "lopes(searchIdx, 1) = getSlope(...\n                    raiseLaSlopePointsIdxs,...\n                    raiseBuf"
      "ferIdx,...\n                    Ts,...\n                    raiseBufLiftAngle,...\n                    raiseBufT"
      "iltExt,...\n                    raiseBufTiltHePress,...\n                    raiseBufTiltRePress,...\n          "
      "          raiseBufLiftPress,...\n                    raiseBufImuX,...\n                    raiseBufImuY,...\n   "
      "                 raiseBufImuZ,...\n                    raiseBufSteerAngle,...\n                    searchPitchOf"
      "fset,...\n                    searchIdx,...\n                    toa_appNumber, toa_tiltBoreDia, toa_tiltRodDia,"
      " toa_liftBoreDia, toa_tiltNumCyl, toa_toolBcLength...\n                );\n            end\n            if lower"
      "Done\n                searchLowerSlopes(searchIdx, 1) = getSlope(...\n                    lowerLaSlopePointsIdxs"
      ",...\n                    lowerBufferIdx,...\n                    Ts,...\n                    lowerBufLiftAngle,"
      "...\n                    lowerBufTiltExt,...\n                    lowerBufTiltHePress,...\n                    l"
      "owerBufTiltRePress,...\n                    lowerBufLiftPress,...\n                    lowerBufImuX,...\n       "
      "             lowerBufImuY,...\n                    lowerBufImuZ,...\n                    lowerBufSteerAngle,...\n"
      "                    searchPitchOffset,...\n                    searchIdx,...\n                    toa_appNumber,"
      " toa_tiltBoreDia, toa_tiltRodDia, toa_liftBoreDia, toa_tiltNumCyl, toa_toolBcLength...\n                );\n    "
      "        end\n        end\n        if lowerDone && raiseDone\n            searchRaiseWeight = calcMass(...\n     "
      "           raiseBufferIdx,...\n                Ts,...\n                raiseBufLiftAngle,...\n                ra"
      "iseBufTiltExt,...\n                raiseBufTiltHePress,...\n                raiseBufTiltRePress,...\n           "
      "     raiseBufLiftPress,...\n                raiseBufImuX,...\n                raiseBufImuY,...\n                "
      "raiseBufImuZ,...\n                raiseBufSteerAngle,...\n                searchPitchOffset,...\n               "
      " toa_appNumber, toa_tiltBoreDia, toa_tiltRodDia, toa_liftBoreDia, toa_tiltNumCyl, toa_toolBcLength...\n         "
      "   );\n            searchLowerWeight = calcMass(...\n                lowerBufferIdx,...\n                Ts,...\n"
      "                lowerBufLiftAngle,...\n                lowerBufTiltExt,...\n                lowerBufTiltHePress,"
      "...\n                lowerBufTiltRePress,...\n                lowerBufLiftPress,...\n                lowerBufImu"
      "X,...\n                lowerBufImuY,...\n                lowerBufImuZ,...\n                lowerBufSteerAngle,.."
      ".\n                searchPitchOffset,...\n                toa_appNumber, toa_tiltBoreDia, toa_tiltRodDia, toa_li"
      "ftBoreDia, toa_tiltNumCyl, toa_toolBcLength...\n            );\n            searchNoFricWeight = (searchRaiseWei"
      "ght(raiseLaSlopePointsIdxs) + searchLowerWeight(fliplr(lowerLaSlopePointsIdxs))) / 2;\n            dummy = polyf"
      "it(RAISE_LA_SLOPE_POINTS, searchNoFricWeight, 1);\n            searchNoFricSlope = dummy(1);\n            search"
      "NoFricSlopes(searchIdx) = searchNoFricSlope;\n            if abs(searchNoFricSlope) < abs(searchLeastSlope)\n   "
      "             searchLeastSlope = searchNoFricSlope;\n                searchLeastSlopeIdx = searchIdx;\n          "
      "      searchLeastSlopePitchOffset = searchPitchOffset;\n                searchLeastSlopeLumpedWeight = mean(sear"
      "chNoFricWeight);\n            end\n        end\n    end\n    \n    % Calculate results and print them\n    if DE"
      "BUG\n        if raiseDone\n            [dummy, raiseFlattestSlopeSearchIdx] = min(abs(searchRaiseSlopes));\n    "
      "        raiseFlattestSlope = searchRaiseSlopes(raiseFlattestSlopeSearchIdx);\n            raisePitchOffset = SEA"
      "RCH_PITCH_OFFSETS(raiseFlattestSlopeSearchIdx);\n            disp('# Raise Pitch Result #')\n            fprintf"
      "('## Slope = %.4f\\n## Index = %f\\n## Pitch = %.4f\\n', raiseFlattestSlope, raiseFlattestSlopeSearchIdx, raiseP"
      "itchOffset)\n            disp(raisePitchOffset)\n        else\n            raisePitchOffset = single(NaN);\n    "
      "    end\n\n        if lowerDone\n            [dummy, lowerFlattestSlopeSearchIdx] = min(abs(searchLowerSlopes));"
      "\n            lowerFlattestSlope = searchLowerSlopes(lowerFlattestSlopeSearchIdx);\n            lowerPitchOffset"
      " = SEARCH_PITCH_OFFSETS(lowerFlattestSlopeSearchIdx);\n            disp('# Lower Pitch Result #')\n            f"
      "printf('## Slope = %.4f\\n## Index = %f\\n## Pitch = %.4f\\n', lowerFlattestSlope, lowerFlattestSlopeSearchIdx, "
      "lowerPitchOffset)\n            disp(lowerPitchOffset)\n        else\n            lowerPitchOffset = single(NaN);"
      "\n        end\n    end\n    \n    if raiseDone && lowerDone\n        disp('# Frictionless Pitch Result #')\n    "
      "    fprintf('## Slope = %.4f\\n## Index = %f\\n## Pitch = %.4f\\n## Weight = %.4f\\n', searchLeastSlope, searchL"
      "eastSlopeIdx, searchLeastSlopePitchOffset, searchLeastSlopeLumpedWeight)\n        disp(searchLeastSlopePitchOffs"
      "et)\n    end\n    \n    % Set return value and return\n    if raiseDone && lowerDone\n        pitchOffset = sear"
      "chLeastSlopePitchOffset;\n        lumpedWeight = searchLeastSlopeLumpedWeight;\n    else\n        pitchOffset = "
      "single(NaN);\n        lumpedWeight = single(NaN);\n    end\n    fprintf('# Returned Pitch Offset = %.4f\\n', pit"
      "chOffset);\n    return\nend\n\n% Data Collection - Raise\nif calDirectionFlag == 0 % Raise\n    if raiseBufferId"
      "x == BUFFER_LEN\n        fprintf('IMU Cal: Raise data capture failed due to buffer too small!\\n');\n        rai"
      "seFailed = true;\n    end\n    if liftHeight > RAISE_START_HEIGHT\n        raiseStarted = true;\n    end\n    if"
      " liftHeight > RAISE_END_HEIGHT\n        raiseDone = true;\n    end\n    if raiseStarted && ~raiseDone && ~raiseF"
      "ailed\n        raiseBufferIdx = raiseBufferIdx + 1;\n        raiseBufTiltHePress(raiseBufferIdx) = tiltHePress;\n"
      "        raiseBufTiltRePress(raiseBufferIdx) = tiltRePress;\n        raiseBufLiftPress(raiseBufferIdx) = liftPres"
      "s;\n        raiseBufImuX(raiseBufferIdx) = imuX;\n        raiseBufImuY(raiseBufferIdx) = imuY;\n        raiseBuf"
      "ImuZ(raiseBufferIdx) = imuZ;\n        raiseBufLiftAngle(raiseBufferIdx) = liftAngle;\n        raiseBufTiltExt(ra"
      "iseBufferIdx) = tiltExt;\n        raiseBufSteerAngle(raiseBufferIdx) = steerAngle;\n        \n        if ~raiseL"
      "aSlopePointsDone && liftAngle > RAISE_LA_SLOPE_POINTS(raiseLaSlopePointsIdx)\n            raiseLaSlopePointsIdxs"
      "(raiseLaSlopePointsIdx) = raiseBufferIdx;\n            if raiseLaSlopePointsIdx < LA_SLOPE_POINTS_NUM\n         "
      "       raiseLaSlopePointsIdx = raiseLaSlopePointsIdx + 1;\n                if liftAngle > RAISE_LA_SLOPE_POINTS("
      "raiseLaSlopePointsIdx)\n                    % Already passed next slope point unexpectedly\n                    "
      "raiseFailed = true;\n                    fprintf('IMU Cal: Raise data capture failed due to func not called freq"
      "uently enough!\\n');\n                end\n            else\n                raiseLaSlopePointsDone = true;\n   "
      "         end\n        end\n    end\n    pitchOffset = single(NaN);\n    lumpedWeight = single(NaN);\n    return\n"
      "end\n\n% Data Collection - Lower\nif calDirectionFlag == 1 % Lower\n    if lowerBufferIdx == BUFFER_LEN\n       "
      " fprintf('IMU Cal: Lower data capture failed due to buffer too small!\\n');\n        lowerFailed = true;\n    en"
      "d\n    if liftHeight < LOWER_START_HEIGHT\n        lowerStarted = true;\n    end\n    if liftHeight < LOWER_END_"
      "HEIGHT\n        lowerDone = true;\n    end\n    if lowerStarted && ~lowerDone && ~lowerFailed\n        lowerBuff"
      "erIdx = lowerBufferIdx + 1;\n        lowerBufTiltHePress(lowerBufferIdx) = tiltHePress;\n        lowerBufTiltReP"
      "ress(lowerBufferIdx) = tiltRePress;\n        lowerBufLiftPress(lowerBufferIdx) = liftPress;\n        lowerBufImu"
      "X(lowerBufferIdx) = imuX;\n        lowerBufImuY(lowerBufferIdx) = imuY;\n        lowerBufImuZ(lowerBufferIdx) = "
      "imuZ;\n        lowerBufLiftAngle(lowerBufferIdx) = liftAngle;\n        lowerBufTiltExt(lowerBufferIdx) = tiltExt"
      ";\n        lowerBufSteerAngle(lowerBufferIdx) = steerAngle;\n        \n        if ~lowerLaSlopePointsDone && lif"
      "tAngle < LOWER_LA_SLOPE_POINTS(lowerLaSlopePointsIdx)\n            lowerLaSlopePointsIdxs(lowerLaSlopePointsIdx)"
      " = lowerBufferIdx;\n            if lowerLaSlopePointsIdx < LA_SLOPE_POINTS_NUM\n                lowerLaSlopePoin"
      "tsIdx = lowerLaSlopePointsIdx + 1;\n                if liftAngle < LOWER_LA_SLOPE_POINTS(lowerLaSlopePointsIdx)\n"
      "                    % Already passed next slope point unexpectedly\n                    lowerFailed = true;\n   "
      "                 fprintf('IMU Cal: Lower data capture failed due to func not called frequently enough!\\n');\n  "
      "              end\n            else\n                lowerLaSlopePointsDone = true;\n            end\n        en"
      "d\n    end\n    pitchOffset = single(NaN);\n    lumpedWeight = single(NaN);\n    return\nend\n\n% We should neve"
      "r get down here\npitchOffset = single(NaN);\nlumpedWeight = single(NaN);\nreturn\n\n    function slope = getSlop"
      "e(laSlopePointIdxs, endDataIdx, Ts, bufLiftAngle, bufTiltExt, bufTiltHePress, bufTiltRePress, bufLiftPress, bufI"
      "muX, bufImuY, bufImuZ, bufSteerAngle, pitchOffset, searchIdx, ...\n                              toa_appNumber, "
      "toa_tiltBoreDia, toa_tiltRodDia, toa_liftBoreDia, toa_tiltNumCyl, toa_toolBcLength)\n        % Calculates raw TO"
      "A weight and filters it with a phaseless notch\n        % filter. Then, calculates the slope of lift angle vs. w"
      "eight, as\n        % sampled at the LA slope points.\n        z = searchIdx;\n        bufferLen = length(bufLift"
      "Angle);\n        weights = single(zeros(1, bufferLen));\n        weightsFilt = single(zeros(1, bufferLen));\n   "
      "     phaselessTemp = single(zeros(1, bufferLen));\n        slopePointWeightsFilt = single(zeros(1, 21));\n      "
      "  slopePointsLiftAngles = single(zeros(1, 21));\n        for idx = 1:endDataIdx\n            weights(idx) = toa_"
      "imuCalPayload(...\n                    bufLiftAngle(idx),...\n                    bufTiltExt(idx),...\n         "
      "           bufTiltHePress(idx),...\n                    bufTiltRePress(idx),...\n                    bufLiftPres"
      "s(idx),...\n                    bufImuX(idx),...\n                    bufImuY(idx),...\n                    bufI"
      "muZ(idx),...\n                    bufSteerAngle(idx),...\n                    pitchOffset,...\n                 "
      "   toa_appNumber, toa_tiltBoreDia, toa_tiltRodDia, toa_liftBoreDia, toa_tiltNumCyl, toa_toolBcLength...\n       "
      "     );\n            if idx == 1\n                dummy = notchFilter(weights(idx), true, Ts);  %reset filter\n "
      "           end\n            phaselessTemp(idx) = notchFilter(weights(idx), false, Ts);\n        end\n        dum"
      "my = notchFilter(phaselessTemp(endDataIdx), true, Ts);   %reset filter to prepare for reverse pass\n        for "
      "idx = 1:endDataIdx\n            reverseIdx = endDataIdx - idx + 1;\n            weightsFilt(reverseIdx) = notchF"
      "ilter(phaselessTemp(reverseIdx), false, Ts);\n        end\n        for spIdx = 1:21\n            slopePointsLift"
      "Angles(spIdx) = bufLiftAngle(laSlopePointIdxs(spIdx));\n            slopePointWeightsFilt(spIdx) = weightsFilt(l"
      "aSlopePointIdxs(spIdx));\n        end\n        dummy = polyfit(slopePointsLiftAngles, slopePointWeightsFilt, 1);"
      "\n        slope = dummy(1);\n        return\n        \n    function weightsFilt = calcMass(endDataIdx, Ts, bufLi"
      "ftAngle, bufTiltExt, bufTiltHePress, bufTiltRePress, bufLiftPress, bufImuX, bufImuY, bufImuZ, bufSteerAngle, pit"
      "chOffset, ...\n                                    toa_appNumber, toa_tiltBoreDia, toa_tiltRodDia, toa_liftBoreD"
      "ia, toa_tiltNumCyl, toa_toolBcLength)\n        % Calculates raw TOA weight and filters it with a phaseless notch"
      "\n        % filter.\n        bufferLen = length(bufLiftAngle);\n        weights = single(zeros(1, bufferLen));\n"
      "        weightsFilt = single(zeros(1, bufferLen));\n        phaselessTemp = single(zeros(1, bufferLen));\n      "
      "  for idx = 1:endDataIdx\n            weights(idx) = toa_imuCalPayload(...\n                    bufLiftAngle(idx"
      "),...\n                    bufTiltExt(idx),...\n                    bufTiltHePress(idx),...\n                   "
      " bufTiltRePress(idx),...\n                    bufLiftPress(idx),...\n                    bufImuX(idx),...\n     "
      "               bufImuY(idx),...\n                    bufImuZ(idx),...\n                    bufSteerAngle(idx),.."
      ".\n                    pitchOffset,...\n                    toa_appNumber, toa_tiltBoreDia, toa_tiltRodDia, toa_"
      "liftBoreDia, toa_tiltNumCyl, toa_toolBcLength...\n            );\n            if idx == 1\n                dummy"
      " = notchFilter(weights(idx), true, Ts);  %reset filter to prepare for forward pass\n            end\n           "
      " phaselessTemp(idx) = notchFilter(weights(idx), false, Ts);\n        end\n        dummy = notchFilter(phaselessT"
      "emp(endDataIdx), true, Ts);   %reset filter to prepare for reverse pass\n        for idx = 1:endDataIdx\n       "
      "     reverseIdx = endDataIdx - idx + 1;\n            weightsFilt(reverseIdx) = notchFilter(phaselessTemp(reverse"
      "Idx), false, Ts);\n        end\n        \n        return\n"
      editorLayout	      "100 M4x1[10 5 700 500]"
    }
  }
