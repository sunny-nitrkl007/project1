    superState		    SUBCHART
    subviewer		    2
    ssIdNumber		    1
    type		    FUNC_STATE
    decomposition	    CLUSTER_STATE
    eml {
      isEML		      1
      script		      "function status = pfwStatus(inputsBad, latched, measCondOk)\n\nif inputsBad\n    status = TipAssi"
      "stPfwStatus_t.FAULT;\nelseif latched && measCondOk\n    % Let consumers know that PFW is valid and may improve i"
      "n confidence\n    status = TipAssistPfwStatus_t.VALID_MEASURING;\nelseif latched && ~measCondOk\n    % Let consu"
      "mers know that PFW is valid, but won't improve in confidence\n    status = TipAssistPfwStatus_t.VALID_NOT_MEASUR"
      "ING;\nelseif ~latched && measCondOk\n    % Let consumers know that PFW is likely about to become valid\n    stat"
      "us = TipAssistPfwStatus_t.PENDING;\nelse\n    status = TipAssistPfwStatus_t.INVALID;\nend\n"
      editorLayout	      "100 M4x1[10 5 700 500]"
    }
  }
