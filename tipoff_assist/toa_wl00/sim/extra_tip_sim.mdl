  chart {
    id			    86
    machine		    1
    name		    "Tip-Off Assist Payload/Pseudo-Frictionless Weigh/Statistics Estimation/MATLAB Function"
    windowPosition	    [357.12 483.496 167 391]
    viewLimits		    [0 156.75 0 153.75]
    screen		    [1 1 1280 1024 1.041666666666667]
    treeNode		    [0 87 0 0]
    viewObj		    86
    visible		    1
    subviewS {
    }
    ssIdHighWaterMark	    8
    decomposition	    CLUSTER_CHART
    type		    EML_CHART
    chartFileNumber	    11
