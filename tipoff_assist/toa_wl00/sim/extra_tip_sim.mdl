  state {
    id			    28
    labelString		    "eML_blk_kernel()"
    position		    [18 64.5 118 66]
    fontSize		    12
    chart		    27
    treeNode		    [27 0 0 0]
    superState		    SUBCHART
    subviewer		    27
    ssIdNumber		    1
    type		    FUNC_STATE
    decomposition	    CLUSTER_STATE
    eml {
      isEML		      1
      script		      "function neefVector  = fcn(eefVector, steeringAngle)\n% Transforms a vector on the EEF to a vecto"
      "r on the NEEF via steering angle\nrotAxis = [0; 1; 0];               % Steering right is positive angle\nangle ="
      " steeringAngle;\n\n% Form rotation matrix\ncrossProductMatrix = [\n    0,          -rotAxis(3),  rotAxis(2);\n  "
      "   rotAxis(3), 0,          -rotAxis(1);\n    -rotAxis(2), rotAxis(1),  0\n];\ntensorProduct = rotAxis * transpos"
      "e(rotAxis);\nrotMatrix = cos(angle) * eye(3) + sin(angle) * crossProductMatrix + ...\n    (1 - cos(angle)) * ten"
      "sorProduct;\n\nneefVector = rotMatrix * eefVector;"
      editorLayout	      "100 M4x1[10 5 700 500]"
    }
  }
