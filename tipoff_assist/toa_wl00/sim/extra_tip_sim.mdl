    firstTransition	    94
    firstJunction	    93
  }
  state {
    id			    87
    labelString		    "eML_blk_kernel()"
    position		    [18 64.5 118 66]
    fontSize		    12
    chart		    86
    treeNode		    [86 0 0 0]
    superState		    SUBCHART
    subviewer		    86
    ssIdNumber		    1
    type		    FUNC_STATE
    decomposition	    CLUSTER_STATE
    eml {
      isEML		      1
      script		      "function [meanEst, stdevEst] = fcn(newSample, filterFactor, reset)\n% Implements a running mean a"
      "nd standard deviation estimate.\n% Formula from:\n%   Estimation of Variance by a Recursive Equation\n%   by M. "
      "Melvin Bruce, October 1969, Langley Research Center (NASA)\n% Adapted from PCS's pcs_io.c file.\n\npersistent la"
      "stMeanEst lastVarianceEst;\n\n% Init to a high variance to ensure confidence is initially low.\n% Note that the "
      "choice of mean initialization value determines to which\n% side the weight will err.\nif isempty(lastMeanEst) ||"
      " reset\n    lastMeanEst = single(newSample);\n    lastVarianceEst = single(20);\nend\n\nA = 1 - filterFactor;   "
      "% \"A\" from the NASA paper\nmeanEst = A * lastMeanEst + (1.0 - A) * newSample;\nvarianceEst = A * lastVarianceE"
      "st + (1.0 - A) * (1.0 + A) * (newSample - lastMeanEst) * (newSample - lastMeanEst) / 2.0;\nstdevEst = sqrt(varia"
      "nceEst);\n\n% For next time...\nlastMeanEst = meanEst;\nlastVarianceEst = varianceEst;\nend"
      editorLayout	      "100 M4x1[10 5 700 500]"
    }
  }
