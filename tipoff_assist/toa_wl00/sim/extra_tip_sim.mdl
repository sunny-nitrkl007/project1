    eml {
      isEML		      1
      script		      "function rotations  = decomp(rotMatrix)\n%   Input:  3x3 rotation matrix\n%   Output: 1x3 vector "
      "of euler angles in degrees\nrotations = zeros(1,3);\nrotations(1) = atan2(rotMatrix(3,2),rotMatrix(3,3));\nrotat"
      "ions(2) = atan2(-rotMatrix(3,1), (sqrt((rotMatrix(3,2)^2)+(rotMatrix(3,3)^2))));\nrotations(3) = atan2(rotMatrix"
      "(2,1),rotMatrix(1,1));\n% convert back to degrees\nfor i=1:size(rotations,2)\n    rotations(i) = 180*rotations(i"
      ")/pi;\nend\nend"
      editorLayout	      "100 M4x1[10 5 700 500]"
    }
  }
