		$PropName		"MaskObject"
		$ObjectID		32
		$ClassName		"Simulink.Mask"
		Type			"Discrete Derivative"
		Description		"Simulink:masks:DiscreteDerivative_MD"
		Initialization		"\nblkH = gcbh;\nblkName = getfullname(blkH);\n\nif (gainval == 0.0)\n    %avoid divide by zero warn"
		"ing\n    inverseGainval = inf;\nelse\n    inverseGainval = 1.0/double(gainval);\nend\n\nif isequal(OutDataTypeStr, '"
		"Inherit: Inherit via internal rule')\n    diffDT   = 'Inherit: Inherit via back propagation';\n    tsampDT  = 'Inher"
		"it: Inherit via internal rule';\n    tsampImp = 'Offline Scaling Adjustment';\nelse    \n    diffDT   = OutDataTypeS"
		"tr;\n    tsampDT  = 'Inherit: Inherit via back propagation';\n    tsampImp = 'Online Calculations';\nend\n\nif ~strc"
		"mp(get_param(bdroot(blkH),'SimulationStatus'), 'running')\n    set_param([blkName,'/Diff'], ...\n              'RndM"
		"eth',RndMeth, ...\n	          'DoSatur',DoSatur);\n    set_param([blkName,'/TSamp'], ...\n              'OutDataType"
		"Str',tsampDT, ...\n              'RndMeth',RndMeth, ...\n              'DoSatur',DoSatur, ...\n              'TsampM"
		"athImp',tsampImp);\nend\n\nset_param([blkName,'/Resettable Delay'], ...\n	'InputProcessing',InputProcessing);\n"
		SelfModifiable		"on"
		Display			"text(0.5, 0.5, 'K (z-1)', 'horizontalAlignment', 'center', 'verticalAlignment', 'bottom');text(0.5, 0.5, "
		"'Ts z', 'horizontalAlignment', 'center', 'verticalAlignment', 'top');plot([0.3 0.7],[0.5 0.5]);"
		IconOpaque		"opaque-with-ports"
		RunInitForIconRedraw	"off"
		IconUnits		"normalized"
		Capabilities		"slmaskedcaps(gcbh)"
