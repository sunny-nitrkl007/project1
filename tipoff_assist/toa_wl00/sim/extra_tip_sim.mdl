    eml {
      isEML		      1
      script		      "function [outPayload, outStatus]= sendCpmStatus(pfwStatus, pfwPayload, liveStatus, livePayload)\n"
      "\nif pfwStatus == TipAssistPfwStatus_t.VALID_MEASURING || pfwStatus == TipAssistPfwStatus_t.VALID_NOT_MEASURING\n"
      "	outStatus = TipAssistSendCpmStatus_t.PSEUDO_FRICTIONLESS;\n    outPayload = pfwPayload;\nelseif liveStatus == T"
      "ipAssistLiveWeighStatus_t.VALID\n    outStatus = TipAssistSendCpmStatus_t.LIVE;\n    outPayload = livePayload;\n"
      "else\n    outStatus = TipAssistSendCpmStatus_t.INVALID;\n    outPayload = single(NaN);\nend\n"
      editorLayout	      "100 M4x1[10 5 700 500]"
    }
  }
