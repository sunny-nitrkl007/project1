  state {
    id			    50
    labelString		    "eML_blk_kernel()"
    position		    [18 64.5 118 66]
    fontSize		    12
    chart		    49
    treeNode		    [49 0 0 0]
    superState		    SUBCHART
    subviewer		    49
    ssIdNumber		    1
    type		    FUNC_STATE
    decomposition	    CLUSTER_STATE
    eml {
      isEML		      1
      script		      "function [rotMatrix, rotAxis, angle] = fcn(level_vec_meas, level_vec_act)\n% Should match output "
      "of:\n%     vrrotvec2mat(vrrotvec(level_vec_meas, level_vec_act))\n\nif all(level_vec_meas == level_vec_act)\n   "
      " % No transform necessary, return identity matrix\n    rotAxis = single([9999; 9999; 9999]);\n    angle = single"
      "(9999);\n    rotMatrix = single(eye(3));\n    return\nend\n    \na = level_vec_meas;\nb = level_vec_act;\n\ncp ="
      " cross(a, b);\ncpNorm = norm(cp);\n\nrotAxis = cp/cpNorm;\nangle_rad = atan(cpNorm/dot(a, b));\nangle = angle_ra"
      "d * 180.0 / pi;\n\n% Form rotation matrix\ncrossProductMatrix = [\n    0,          -rotAxis(3),  rotAxis(2);\n  "
      "   rotAxis(3), 0,          -rotAxis(1);\n    -rotAxis(2), rotAxis(1),  0\n];\ntensorProduct = rotAxis * transpos"
      "e(rotAxis);\nrotMatrix = cos(angle_rad) * eye(3) + sin(angle_rad) * crossProductMatrix + ...\n    (1 - cos(angle"
      "_rad)) * tensorProduct;"
      editorLayout	      "100 M4x1[10 5 700 500]"
    }
  }
