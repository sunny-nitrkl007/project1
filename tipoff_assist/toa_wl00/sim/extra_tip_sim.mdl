  chart {
    id			    238
    machine		    1
    name		    "Tip-Off Assist Payload/Pseudo-Frictionless Weigh/Statistics Estimation1/Two Sided St. Dev. from Bound"
    windowPosition	    [422 539.941 189 413]
    viewLimits		    [0 156.75 0 153.75]
    screen		    [1 1 3600 1200 1.180555555555556]
    treeNode		    [0 239 0 0]
    viewObj		    238
    visible		    1
    subviewS {
    }
    ssIdHighWaterMark	    6
    decomposition	    CLUSTER_CHART
    type		    EML_CHART
    chartFileNumber	    18
    disableImplicitCasting  1
    eml {
      name		      "TwoSidedConfBound"
    }
    firstData		    240
    firstTransition	    244
    firstJunction	    243
  }
  state {
    id			    239
    labelString		    "eML_blk_kernel()"
    position		    [18 64.5 118 66]
    fontSize		    12
    chart		    238
    treeNode		    [238 0 0 0]
    superState		    SUBCHART
    subviewer		    238
    ssIdNumber		    1
    type		    FUNC_STATE
    decomposition	    CLUSTER_STATE
    eml {
      isEML		      1
      script		      "function stdev = TwoSidedConfBound(confidence, bound)\n% Calculates the st. dev. of a confidence "
      "interval in terms of half its width.\n%\n% Inputs:\n%   confidence\n%   Confidence that the input bound will enc"
      "lose the true value.\n%\n%   bound\n%   Bound of the confidence interval, expressed in the same units as stdev.\n"
      "%   \n%   For lower bound, the true value will lie above the mean minus this\n%   value.\n%   The opposite is tr"
      "ue for an upper bound.\n%\n%   Potential units for the arguments are percent of rated payload or\n%   payload.\n"
      "%\n% Outputs:\n%   stdev\n%   The standard deviation, expressed in the same units as\n%   bound, that correspond"
      "s to the given bound. Can be thought of as\n%   describing the scale of the normal distribution whose confidence"
      "\n%   interval with given bounds results in the given confidence.\n%   \n% Inspired from pcs_calculate_confidenc"
      "e() in pcs_io.c\n\n% Table of confidence vs two-sided confidence interval bound.\n% Units of confidence decimal "
      "percent and the ratio of standard\n% deviation of a standard normal distribution.\nxConfidenceTwoSided = [ 0.0, "
      "0.235822844, 0.382924922, 0.516072694, 0.631879747, 0.728667676, 0.806398927, 0.866385543, 0.910869057, 0.942566"
      "872, 0.964271153, 0.978551778, 0.987580668, 0.993066052, 0.997300204, 0.999534742, 1.0 ];\nyStdevRatio = [ 0.0, "
      "0.3, 0.5, 0.7, 0.9, 1.1, 1.3, 1.5, 1.7, 1.9, 2.1, 2.3, 2.5, 2.7, 3.0, 3.5, 4.0 ];\nstdev_ratio = interp1(xConfid"
      "enceTwoSided, yStdevRatio, confidence);\nstdev = bound / stdev_ratio;"
      editorLayout	      "100 M4x1[10 5 700 500]"
    }
  }
