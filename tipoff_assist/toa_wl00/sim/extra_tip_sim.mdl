  state {
    id			    12
    labelString		    "eML_blk_kernel()"
    position		    [18 64.5 118 66]
    fontSize		    12
    chart		    11
    treeNode		    [11 0 0 0]
    superState		    SUBCHART
    subviewer		    11
    ssIdNumber		    1
    type		    FUNC_STATE
    decomposition	    CLUSTER_STATE
    eml {
      isEML		      1
      script		      "function bound = TwoSidedConfBound(confidence, stdev)\n% Calculates the size of a confidence inte"
      "rval in terms of half its width.\n%\n% Inputs:\n%   confidence\n%   Confidence that the resulting bound will enc"
      "lose the true value.\n%\n%   stdev\n%   The observed standard deviation, expressed in the same units as\n%   bou"
      "nd. Can be thought of as defining the scale of the normal\n%   distribution that we are assuming represents the "
      "data we are sampling.\n%\n%   Potential units for the arguments are percent of rated payload or\n%   payload.\n%"
      "\n% Outputs:\n%   bound\n%   Bound of the confidence interval, expressed in the same units as stdev.\n%   \n%   "
      "For lower bound, the true value will lie above the mean minus this\n%   value.\n%   The opposite is true for an "
      "upper bound.\n%   \n% Inspired from pcs_calculate_confidence() in pcs_io.c\n\n% Table of confidence vs two-sided"
      " confidence interval bound.\n% Units of confidence decimal percent and the ratio of standard\n% deviation of a s"
      "tandard normal distribution.\nxConfidenceTwoSided = [ 0.0, 0.235822844, 0.382924922, 0.516072694, 0.631879747, 0"
      ".728667676, 0.806398927, 0.866385543, 0.910869057, 0.942566872, 0.964271153, 0.978551778, 0.987580668, 0.9930660"
      "52, 0.997300204, 0.999534742, 1.0 ];\nyStdevRatio = [ 0.0, 0.3, 0.5, 0.7, 0.9, 1.1, 1.3, 1.5, 1.7, 1.9, 2.1, 2.3"
      ", 2.5, 2.7, 3.0, 3.5, 4.0 ];\nstdev_ratio = interp1(xConfidenceTwoSided, yStdevRatio, confidence);\nbound = stde"
      "v_ratio * stdev;"
      editorLayout	      "100 M4x1[10 5 700 500]"
    }
  }
