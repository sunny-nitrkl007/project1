  state {
    id			    105
    labelString		    "eML_blk_kernel()"
    position		    [18 64.5 118 66]
    fontSize		    12
    chart		    104
    treeNode		    [104 0 0 0]
    superState		    SUBCHART
    subviewer		    104
    ssIdNumber		    1
    type		    FUNC_STATE
    decomposition	    CLUSTER_STATE
    eml {
      isEML		      1
      script		      "function [meanEst, stdevEst] = fcn(newSample, filterFactor, reset, resetSample, resetVariance)\n%"
      " Implements a running mean and standard deviation estimate.\n% Formula from:\n%   Estimation of Variance by a Re"
      "cursive Equation\n%   by M. Melvin Bruce, October 1969, Langley Research Center (NASA)\n% Adapted from PCS's pcs"
      "_io.c file.\n\npersistent lastMeanEst lastVarianceEst;\n\n% Init to a high variance to ensure confidence is init"
      "ially low.\n% Init to a high mean so the true value is always approached from above,\n% which will ensure a non-"
      "warmed-up filter errs high, which will cause\n% Tip-Off Assist to err low to prevent truck overload.\nif isempty"
      "(lastMeanEst) || reset\n    lastMeanEst = single(resetSample);\n    lastVarianceEst = single(resetVariance);\nen"
      "d\n\nA = 1 - filterFactor;   % \"A\" from the NASA paper\nmeanEst = A * lastMeanEst + (1.0 - A) * newSample;\nva"
      "rianceEst = A * lastVarianceEst + (1.0 - A) * (1.0 + A) * (newSample - lastMeanEst) * (newSample - lastMeanEst) "
      "/ 2.0;\nstdevEst = sqrt(varianceEst);\n\n% For next time...\nlastMeanEst = meanEst;\nlastVarianceEst = varianceE"
      "st;\nend"
      editorLayout	      "100 M4x1[10 5 700 500]"
    }
  }
