  chart {
    id			    78
    machine		    1
    name		    "Tip-Off Assist Payload/Pseudo-Frictionless Weigh/Weighing Statistics/Two Sided Confidence Limit"
    windowPosition	    [422 539.941 189 413]
    viewLimits		    [0 156.75 0 153.75]
    screen		    [1 1 3600 1200 1.180555555555556]
    treeNode		    [0 79 0 0]
    viewObj		    78
    visible		    1
    subviewS {
    }
    ssIdHighWaterMark	    6
    decomposition	    CLUSTER_CHART
    type		    EML_CHART
    chartFileNumber	    10
