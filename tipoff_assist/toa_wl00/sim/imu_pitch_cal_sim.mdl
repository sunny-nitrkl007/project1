  state {
    id			    31
    labelString		    "eML_blk_kernel()"
    position		    [18 64.5 118 66]
    fontSize		    12
    chart		    30
    treeNode		    [30 0 0 0]
    superState		    SUBCHART
    subviewer		    30
    ssIdNumber		    1
    type		    FUNC_STATE
    decomposition	    CLUSTER_STATE
    eml {
      isEML		      1
      script		      "function rotMatrix = fcn(angle)\n% Calculates a rotation matrix from an angle in deg\nif angle =="
      " 0\n    rotMatrix = single(eye(3));\n    return\nend\n\nangleRad = angle / 180.0 * pi;\n\n% Form rotation matrix"
      "\na = cos(angleRad);\nb = sin(angleRad);\nrotMatrix = inv([   % Inversion to make Y rot into neg Y rot\n    a, 0"
      ", b;\n    0, 1, 0;\n    -b, 0, a\n    ]);\n"
      editorLayout	      "100 M4x1[10 5 700 500]"
    }
  }
