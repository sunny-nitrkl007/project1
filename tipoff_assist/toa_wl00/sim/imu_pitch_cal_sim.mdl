  chart {
    id			    59
    machine		    1
    name		    "EEF IMU to NEEF gravity vector/rotation matrix calc\nfrom two vectors"
    windowPosition	    [422 539.941 189 413]
    viewLimits		    [0 156.75 0 153.75]
    screen		    [1 1 3600 1200 1.180555555555556]
    treeNode		    [0 60 0 0]
    viewObj		    59
    ssIdHighWaterMark	    8
    decomposition	    CLUSTER_CHART
    type		    EML_CHART
    chartFileNumber	    7
    disableImplicitCasting  1
    eml {
      name		      "fcn"
    }
