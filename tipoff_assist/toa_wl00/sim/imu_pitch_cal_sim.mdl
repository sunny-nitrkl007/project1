      isEML		      1
      script		      "function rotMatrix = fcn(angle)\n% Calculates a rotation matrix from an angle in deg\nif angle =="
      " 0\n    rotMatrix = single(eye(3));\n    return\nend\n\nangleRad = angle / 180.0 * pi;\n\n% Form rotation matrix"
      "\na = cos(angleRad);\nb = sin(angleRad);\nrotMatrix = [\n    a, -b, 0;\n    b, a, 0;\n    0, 0, 1\n    ];\n"
      editorLayout	      "100 M4x1[10 5 700 500]"
    }
  }
