<?xml version="1.0" encoding="UTF-8" ?>

<dds xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">

    <profiles>
        <transport_descriptors>
            <transport_descriptor>
                <transport_id>sandbox_shm_transport</transport_id>
                <type>SHM</type>
            </transport_descriptor>
        </transport_descriptors>

        <participant profile_name="sandbox_server_profile" is_default_profile="true">
            <rtps>
                <useBuiltinTransports>false</useBuiltinTransports>
                <userTransports>
                    <transport_id>sandbox_shm_transport</transport_id>
                </userTransports>

                <builtin>
                    <discovery_config>
                        <discoveryProtocol>SERVER</discoveryProtocol>
                    </discovery_config>
                    <metatrafficUnicastLocatorList>
                        <locator>
                            <shm>
                                <port>11811</port>
                            </shm>
                        </locator>
                    </metatrafficUnicastLocatorList>
                </builtin>
            </rtps>
        </participant>
    </profiles>

</dds>
