<?xml version="1.0" encoding="UTF-8" ?>

<dds xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">

    <transport_descriptors>
        <transport_descriptor>
            <transport_id>sandbox_shm_transport</transport_id>
            <type>SHM</type>
            <!-- de-prioritizes dds.shm.<port> reception threads -->
            <default_reception_threads>
                <scheduling_policy>SCHED_OTHER</scheduling_policy>
                <priority>0</priority>
                <affinity>0</affinity>
            </default_reception_threads>
        </transport_descriptor>
    </transport_descriptors>

    <profiles>
        <participant profile_name="ros_default_participant" is_default_profile="true">
            <rtps>
                <useBuiltinTransports>false</useBuiltinTransports>
                <userTransports>
                    <transport_id>sandbox_shm_transport</transport_id>
                </userTransports>

                <!-- de-prioritizes dds.ev.0 (unconfirmed tag name on 2.14, verify before trusting) -->
                <event_thread>
                    <scheduling_policy>SCHED_OTHER</scheduling_policy>
                    <priority>0</priority>
                    <affinity>0</affinity>
                </event_thread>

                <builtin>
                    <discovery_config>
                        <discoveryProtocol>SUPER_CLIENT</discoveryProtocol>
                        <discoveryServersList>
                            <RemoteServer prefix="44.53.00.5f.45.50.52.4f.53.49.4d.41">
                                <metatrafficUnicastLocatorList>
                                    <locator>
                                        <udpv4>
                                            <address>127.0.0.1</address>
                                            <port>11811</port>
                                        </udpv4>
                                    </locator>
                                </metatrafficUnicastLocatorList>
                            </RemoteServer>
                        </discoveryServersList>
                    </discovery_config>
                </builtin>
            </rtps>
        </participant>
    </profiles>

    <domainparticipant_factory profile_name="sandbox_factory_profile" is_default_profile="true">
        <qos>
            <shm_watchdog_thread>
                <scheduling_policy>SCHED_OTHER</scheduling_policy>
                <priority>0</priority>
                <affinity>0</affinity>
            </shm_watchdog_thread>
        </qos>
    </domainparticipant_factory>

</dds>
