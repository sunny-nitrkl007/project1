<?xml version="1.0" encoding="UTF-8" ?>
<!--
    CPM Fast DDS profile, shared by every CPM app (LpsSaJobMgrApp,
    LpsSaWeighApp, ScsToRos2Bridge, and any future app built on
    Ros2TaskWrapper).
-->
<dds xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">

    <profiles>

        <!-- ====================================================================
             1. TRANSPORT: Shared-memory only.
             All CPM apps run on the same host, so UDP transport (and its 4
             listener threads per participant: dds.udp.*)
             ==================================================================== -->
        <transport_descriptors>
            <transport_descriptor>
                <transport_id>cpm_shm_transport</transport_id>
                <type>SHM</type>
                <!-- de-prioritizes dds.shm.<port> reception threads (Fast DDS 2.14, TransportConfigQos) -->
                <default_reception_threads>
                    <scheduling_policy>SCHED_OTHER</scheduling_policy>
                    <priority>0</priority>
                    <affinity>0</affinity>
                </default_reception_threads>
            </transport_descriptor>
        </transport_descriptors>

        <!-- ================================================================
             2. PARTICIPANT PROFILE applied to every CPM app process.
             is_default_profile="true" means every participant created
             without an explicit profile name picks this up automatically,
             so no per-app code changes are needed beyond pointing
             FASTRTPS_DEFAULT_PROFILES_FILE at this file.
             ================================================================ -->
        <participant profile_name="cpm_participant_profile" is_default_profile="true">
            <rtps>
                <useBuiltinTransports>false</useBuiltinTransports>
                <userTransports>
                    <transport_id>cpm_shm_transport</transport_id>
                </userTransports>
                <!-- de-prioritizes dds.ev.0 (unconfirmed tag name on 2.14, verify before trusting) -->
                <event_thread>
                    <scheduling_policy>SCHED_OTHER</scheduling_policy>
                    <priority>0</priority>
                    <affinity>0</affinity>
                </event_thread>
            </rtps>
        </participant>

    </profiles>

    <!-- ====================================================================
         3. THREAD PRIORITY: the one confirmed, documented thread-settings
         hook, the SHM watchdog thread (dds.shm.wdog in the ps -L output),
         configured at the DomainParticipantFactory level, not per-participant.
         ==================================================================== -->
    <domainparticipant_factory profile_name="cpm_factory_profile" is_default_profile="true">
        <qos>
            <shm_watchdog_thread>
                <scheduling_policy>SCHED_OTHER</scheduling_policy>
                <priority>0</priority>
                <affinity>0</affinity>
            </shm_watchdog_thread>
        </qos>
    </domainparticipant_factory>

</dds>
