check process LpsDiscoveryServer with pidfile /run/lps_discovery_server.pid
    start program = "/opt/CPM/scripts/monit_start_discovery.sh" with timeout 20 seconds
    stop program  = "/opt/CPM/scripts/monit_stop_discovery.sh" with timeout 20 seconds

    if does not exist then restart
    if 5 restarts within 10 cycles then unmonitor

    group lps
