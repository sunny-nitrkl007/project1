#!/bin/bash

## Software Information and Verity Naming
## Verity format: (VERITY_PREFIX)_(PLATFORM)_(SOFTWARE_PART_NUMBER)_(SOFTWARE_CHANGE_NUMBER)_(SOFTWARE_BUILD_ID).verity

export SOFTWARE_PART_NUMBER=5715512
                          # ^^^^^^^                                7 bytes, used for Software Group Part Number

# 2 bytes, used for Software Group Part Number
export SOFTWARE_CHANGE_NUMBER=50
                            # ^^

# 7 bytes, used for Software Group Part Number
export SOFTWARE_RELEASE_DATE=SEP2025
                           # ^^^^^^^

# 26 bytes, used for Software Group Part Number, spaces are permitted if encased on quotes
# NOTE: Cannot contain the name of the ECM (A6N1, A6N2, etc), it will be replaced with '1' by the preprocessor
export SOFTWARE_GROUP_DESCRIPTION="MWL PAYLOAD - T99"
                                 # ^^^^^^^^^^^^^^^^^^^^^^^^^^

# Used for Verity name
export SOFTWARE_BUILD_ID=T99

# Used for getversion, name of the release zip file
#export SWVERSION=${SOFTWARE_PART_NUMBER}-${SOFTWARE_CHANGE_NUMBER}${SOFTWARE_RELEASE_DATE}${SOFTWARE_BUILD_ID}

## RPA Client

# 6 Bytes max
export SOFTWARE_NAME_CODE=A4047
                        # ^^^^^^

# Must be int16
export FLASH_APPLICATION_ID=195

## RPA Client - Must be int16
export FLASH_COMPONENT_ID=600

#
# Payload Legal For Trade (LFT) Measurement Software Identifier
# ----------------------------------------------------------------------------
# Used to read the identifier inextricably linked to the legally relevant
# payload measurement software. The Payload Legal For Trade Measurement
# Software Identifier only represents the legally relevant portion of
# software. For example, this software identification could be altered for
# every software change that may affect the metrological functions of the
# instrument. This identifier is application specific.
#
# Standalone product variant is 4.0 and 4.4
# Advanced product variant is 4.1 and 4.5
# Build string format is DDMMMYYYY such as 10May2023
#
export LFT_SW_ID_VERSION=4.4
