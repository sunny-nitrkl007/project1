#!/usr/bin/python
Import( 'baseEnv' )
testEnv = baseEnv.Clone();
Export( 'testEnv' )

testEnv.buildit( 'TireRevTestApp', ['suse'] )
testEnv.buildit( 'DigTimerTestApp', ['suse'] )

if (testEnv[ 'PLATFORM' ] != 'x86_64-linux-gnu'):
    testEnv.buildit( 'OperatorIdTest', ['suse'] )
    # LpsSaTotalsTelemetryTest uses protoc 3.0.0 generated files incompatible with protobuf 5.x
    if testEnv['PLATFORM'] not in ['A7H4']:
        testEnv.buildit( 'LpsSaTotalsTelemetryTest', ['suse'] )