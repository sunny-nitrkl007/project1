testEnv.buildit( 'LpsSaTotalsApp', ['suse'] )
testEnv.buildit( 'WorkOrderAssist', ['suse'] )
testEnv.buildit( 'WidgetApp', ['suse'] )
testEnv.buildit( 'DemoApp', ['suse'] )
#testEnv.buildit( 'AprilTagReader', ['suse'] )

if (testEnv[ 'PLATFORM' ] != 'x86_64-linux-gnu'):
    #if testEnv[ 'PLATFORM' ] not in ['A7H4']:
