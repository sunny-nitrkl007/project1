baseEnv['TES_COMMON_DIR'] = os.environ['TES_COMMON_DIR']
baseEnv['SSP_DIR'] = os.environ['SSP_DIR']
Export( 'baseEnv' )

appEnv = baseEnv.Clone()
Export( 'appEnv' )

### cpm_loader_ais ###

# Needed for cpm_load_ais compatibility
