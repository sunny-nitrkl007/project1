<?xml version="1.0" ?>
<ivy-module version="2.0"
            xmlns:e="http://ant.apache.org/ivy/extra"
            xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
            xsi:noNamespaceSchemaLocation="http://ant.apache.org/ivy/schemas/ivy.xsd"
>
  <info module="cat/ess-info/lps_cal"
        e:ivydom="ivy-mach_productivity"
        e:vpath="lib_mach_productivity/lps/cal/lps_cal"
        organisation="com.cat.e"
        revision="#!RevReplace!#"
        status="integration"
  />
  <configurations defaultconf="rel">
    <conf description="retrieve only artifacts necessary to use the module"   name="rel"/>
	<conf description="retrieve only artifacts necessary to debug the module"   name="rel_debug"/>
    <conf description="retrieve artifacts that are part of this release unit" name="nodep"/>
    <conf description="retrieve artifacts needed to build this release unit"  name="dev"/>
  </configurations>
  <publications>
    <artifact conf="dev,nodep,rel_debug" ext="xml" name="git-repo" type="git"/>
  </publications>  
  <dependencies defaultconf="*->@">    
	<!-- lps_cal -->
	<dependency conf="rel,dev,rel_debug->rel"  e:ivydom="ivy-mach_productivity" name="cat/ess-info/lps_cal_interface"    org="com.cat.e" rev="#!RevReplace!#"/>
	<!-- lps_app_common -->
	<dependency conf="dev->dev"  e:ivydom="ivy-mach_productivity" name="cat/ess-info/lps_app_common"     org="com.cat.e" rev="0.4.0"/>
	<!-- lps_common -->    
	<dependency conf="dev->dev"  e:ivydom="ivy-mach_productivity" name="cat/ess-info/lps_common"     org="com.cat.e" rev="0.3.0"/>
	<!-- platform and tools cluster -->	
	<dependency conf="dev->rel_lib_x5,rel_girt_win32" name="cat/dt/mach_tools_cluster"  rev="11.0.0.rc5"	e:ivydom="ivy-ms_makefiles"	     org="com.cat.e"/>
	<dependency conf="dev->rel_lib"    e:ivydom="ivy-mach"          name="cat/ess-mach/mach_afsw_oel_hal_scl_cluster" org="com.cat.e" rev="10.0.0"/>	  
  </dependencies>
</ivy-module>
