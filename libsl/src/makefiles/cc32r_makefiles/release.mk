########################################################################
# environment/makefiles/release.mk                      clearmake -C gnu
########################################################################

# This supports recursive build of a library or application release for
# all supported targets.

###########################
# Variable Definitions
###########################

# Define host tools
#
include $(MK_DIR2)$/tools_$(OS).mk

REL_ROOT_M = ..$/..

ifndef TGT_ROOT
TGT_ROOT = $(REL_ROOT_M)
REL_ROOT_T = ..
REL_ROOT_L = ..$/..$/..
VOB_ROOT_T = $(REL_ROOT_T)$/$(VOB_ROOT_R)
VOB_ROOT_L = $(REL_ROOT_L)$/$(VOB_ROOT_R)
else
REL_ROOT_T = $$(VOB_ROOT)$/$(REL_ROOT_V)
REL_ROOT_L = $$(VOB_ROOT)$/$(REL_ROOT_V)
VOB_ROOT_T = $$(CLEARCASE_ROOT)
VOB_ROOT_L = $$(CLEARCASE_ROOT)
endif

TGT_DIRS := $(TGT_ARCHS:tgt_%=$(TGT_ROOT)$/tgt_%)

TGT_MAKEFILES := $(TGT_DIRS:%=%$/Makefile)

###########################
# Rules
###########################

.PHONY: $(TGT_ARCHS) targets libs apps all tree clean

# default - This first rule is the default if no targets are specified
#
help:


# all - libs and apps for all target architectures
#
all: targets libs apps


# targets - apply to all target architectures
#
targets: $(TGT_ARCHS) 


# libs - build all libs for specified target architectures
#
libs: ;


# apps - build all apps for specified target architectures
#
apps: ;


# tree - build specific app
#
tree: ;


# clean - remove the target build directory trees
#
clean:
	-$(RMDIR) $(TGT_DIRS)


# TGT_ROOT TGT_DIRS - rules to create these directories
#	
$(TGT_ROOT) $(TGT_DIRS):
	-$(MKDIR) $@ 


# TGT_ARCHS - rules to build target architectures
#   This will create the top level directory structure, create the target
#   archtecture Makefile and recursively call make to continue the build.
#   NOTE: The prerequisite order is important so the parent directories
#   are created first.  Parents directories are not defined as prerequisites
#   to their content because any changes to a directory content changes its
#   date and would cause an attempt to remake all of its content.
#
$(TGT_ARCHS): tgt_%: $(TGT_ROOT) $(TGT_ROOT)$/tgt_% $(TGT_ROOT)$/tgt_%$/Makefile \
  $(TGT_ROOT)$/tgt_%$/Makefile.options
	$(CD) $(TGT_ROOT)$/$@ && "$(MAKE)" $(filter-out targets tgt_%, $(MAKECMDGOALS))


# TGT_MAKEFILES - This will create the target architecture Makefile
#   It is a concatenation of:
#      generated banner
#      environment/makefiles/target.mk
#      environment/makefiles/tools_$(OS).mk
#      environment/makefiles/<tgt_arch>*.mk (optional)
#      environment/makefiles/defs.mk
#      <release>/src/makefiles/defs.mk
#      <release>/src/makefiles/<tgt_arch>*.mk (required)
#      environment/makefiles/srcdef.mk (includes <src dir>/def.mk)
#      environment/makefiles/rules.mk
#
#
#											NOTE-2 NOTE-3 NOTE-19 NOTE-20
$(TGT_MAKEFILES): $(TGT_ROOT)$/%$/Makefile: \
	  $(MK_DIR2)$/release.mk \
	  $(MK_DIR2)$/target.mk \
	  $(MK_DIR2)$/tools_$(OS).mk \
	  $(MK_DIR2)$/tgt_*.mk \
	  $(MK_DIR2)$/defs.mk \
	  $(MK_DIR)$/defs.mk \
	  $(MK_DIR)/%*.mk \
	  $(MK_DIR2)$/srcdefs.mk \
	  $(MK_DIR2)$/rules.mk
	@$(ECHO)# $(patsubst $(TGT_ROOT)$/%,%,$@)$(ECHOEND)>$@_banner
	@$(ECHOEMPTY)>>$@_banner
	@$(ECHO)# This file is autogenerated, DO NOT EDIT$(ECHOEND)>>$@_banner
	@$(ECHOEMPTY)>>$@_banner
	@$(ECHOEMPTY)>>$@_banner
	@$(ECHOEMPTY)>>$@_banner
	@$(ECHOEMPTY)>>$@_banner
	@$(ECHO)VOB_ROOT_T = $(VOB_ROOT_T)$(ECHOEND)>>$@_banner
	@$(ECHO)VOB_ROOT_L = $(VOB_ROOT_L)$(ECHOEND)>>$@_banner
	@$(ECHO)REL_ROOT_T = $(REL_ROOT_T)$(ECHOEND)>>$@_banner
	@$(ECHO)REL_ROOT_L = $(REL_ROOT_L)$(ECHOEND)>>$@_banner
	@$(ECHO)ENV_ROOT = $(DOLLAR)(VOB_ROOT)$/$(ENV_ROOT_V)$(ECHOEND)>>$@_banner
	@$(ECHO)TGT_ARCH = $(notdir $(@D))$(ECHOEND)>>$@_banner
	@$(ECHOEMPTY)>>$@_banner
	$(CAT) \
	  $@_banner \
	  $(CAT_SEPARATOR) $(MK_DIR2)$/target.mk \
	  $(CAT_SEPARATOR) $(MK_DIR2)$/tools_$(OS).mk \
	  $(CAT_SEPARATOR) $(MK_DIR2)$/$(notdir $(@D)).mk \
	  $(CAT_SEPARATOR) $(MK_DIR2)$/$(notdir $(@D))_base.mk \
	  $(CAT_SEPARATOR) $(MK_DIR2)$/defs.mk \
	  $(CAT_SEPARATOR) $(MK_DIR)$/defs.mk \
	  $(CAT_SEPARATOR) $(MK_DIR)$/$(notdir $(@D)).mk \
	  $(CAT_SEPARATOR) $(MK_DIR2)$/srcdefs.mk \
	  $(CAT_SEPARATOR) $(MK_DIR2)$/rules.mk \
	  $(CAT_OUT_PREFIX) $@
	@-$(RM) $@_banner


# Makefile.options - This will create the Makefile.options file
#
$(TGT_ROOT)$/tgt_%$/Makefile.options:  $(MK_DIR)$/Makefile.options
	$(CP) $< $@


# help - provide help
#
help:
	@$(ECHO)Targets:$(ECHOEND) 
	@$(ECHO)  all - libs and apps for all target architectures$(ECHOEND) 
	@$(ECHO)  targets - apply to all target architectures$(ECHOEND) 
	$(foreach i,$(TGT_ARCHS), @$(ECHO)     $(i)$(ECHOEND) &)
	@$(ECHO)    - apply to specific target architectures$(ECHOEND) 
	@$(ECHO)  libs - build all libs for specified target architectures$(ECHOEND) 
	@$(ECHO)  apps - build all apps for specified target architectures$(ECHOEND) 
	@$(ECHO)  tree - create target directory tree without building$(ECHOEND) 
	@$(ECHO)  clean - remove the target build directory trees$(ECHOEND) 
	@$(ECHO)Options:$(ECHOEND) 
	@$(ECHO)  TGT_ROOT=$(QUOTE)[path]$(QUOTE) - alternate output [path]$(ECHOEND) 
	@$(ECHO)  APPDIRS=$(QUOTE)_[path] ...$(QUOTE) - specific apps, [path] is relative to SRC_ROOT$(ECHOEND) 
	@$(ECHO)  LIBDIRS=$(QUOTE)_[path] ...$(QUOTE) - specific libs, [path] is relative to SRC_ROOT$(ECHOEND) 
	@$(ECHOEMPTY)

