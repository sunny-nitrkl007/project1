		<!-- For tgt_diab_4.2b_PPC555EH -->
		<dependency e:ivydom="ivy-csf" org="com.cat.e"          name="cat/ess-csf/oel-tgt_diab_4.2b_PPC555EH-a"       rev="2016.14.0"        conf="dev->rel"/>
		<!-- For tgt_diab_5.8.0.0_PPCVLEEF -->
		<dependency e:ivydom="ivy-csf" org="com.cat.e"          name="cat/ess-csf/oel-tgt_diab_5.8.0.0_PPCVLEEF-a"    rev="2016.14.0"        conf="dev->rel"/>
