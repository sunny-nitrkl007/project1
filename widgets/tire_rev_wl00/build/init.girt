#tire_rev_wl00 Initialize Script
#     This script contains various setup information which is included
#     automatically when girt is invoked from this directory.

#Register Release Entries Which Make Up Entire Release Unit
#     Define each Ivy Module which makes up release.
#     Define in dependency order: lowest to highest.
release entry ivy  source    		../deps/ivy.xml;
release entry ivy  lib_x5		    ../../tire_rev_wl00-a/tgt_diab_5.8.0.0_PPCVLEEF/deps/ivy.xml;
release entry ivy  lib_x6    		../../tire_rev_wl00-a/tgt_diab_5.9.4.0_PPCVLEEF/deps/ivy.xml;
release entry ivy  lib_sim_win64    ../../tire_rev_wl00-a/tgt_sim_gcc_4.8.2_x86-64/deps/ivy.xml;

#Configure Release Commit Mode
#     source_inf: Ensure that repository is clean.
#     source_b:   Ensure that repository is clean.
#     source:     Ensure that repository is clean.
#     lib_x6:     Commit all content.
release mode commit ${source}   		none;
release mode commit ${lib_x5}    		all;
release mode commit ${lib_x6}    		all;
release mode commit ${lib_sim_win64}    all;

#Configure Release Tree Mode
#     source_inf:  	Default.  Content will be added on current branch.
#     source_b:  	Default.  Content will be added on current branch.
#     source:     	Default.  Content will be added on current branch.
#     lib_x6:     	Separate tree will be created for content.
release mode tree   ${lib_x5}   		no;
release mode tree   ${lib_x6}   		no;
release mode tree   ${lib_sim_win64}   	no;